+def test_math_in_list(self):
+    text = '- $$\n  foo\n  $$\n'
+    md1 = create_markdown(escape=False)
+    md2 = create_markdown(escape=False, plugins=['math', math_in_list])
+    self.assertNotIn('class="math"', md1(text))
