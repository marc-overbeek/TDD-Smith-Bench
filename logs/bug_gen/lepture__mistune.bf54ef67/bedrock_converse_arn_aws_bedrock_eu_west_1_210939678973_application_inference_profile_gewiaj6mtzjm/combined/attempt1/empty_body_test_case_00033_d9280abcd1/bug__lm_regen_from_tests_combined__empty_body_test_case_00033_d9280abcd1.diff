+def render_html_toc(renderer: 'BaseRenderer', title: str, collapse: bool=
+    False, **attrs: Any) ->str:
+    if not attrs.get('toc'):
+        return ''
+    if title:
+        title = f'<h2>{title}</h2>'
+    ul = render_toc_ul(attrs['toc'], attrs.get('min_level', 1))
+    if collapse:
+        return f'{title}<details><summary>Contents</summary>{ul}</details>'
+    return f'{title}{ul}'
 
 
