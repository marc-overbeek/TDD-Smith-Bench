+def _normalize_level(options: Dict[str, Any], name: str, default: Any) ->Any:
+    value = options.get(name, default)
+    if isinstance(value, str):
+        try:
+            value = int(value)
+        except ValueError:
+            raise ValueError(f'Invalid "{name}" option: {value}')
+    if not isinstance(value, int) or value < 1 or value > 6:
+        raise ValueError(f'"{name}" option must be an integer between 1 and 6')
