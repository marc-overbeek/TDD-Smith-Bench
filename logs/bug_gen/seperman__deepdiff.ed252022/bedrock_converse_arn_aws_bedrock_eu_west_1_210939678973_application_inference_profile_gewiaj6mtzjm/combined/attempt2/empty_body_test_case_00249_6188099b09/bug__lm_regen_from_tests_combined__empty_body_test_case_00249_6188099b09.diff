+    Get the length of an item for distance calculation purposes.
+    This is used to calculate the rough distance between objects.
+    """
+    if item is None:
+        return 0
+    if isinstance(item, (str, bytes)):
+        return 1
+    if isinstance(item, (int, float, complex)):
+        return 1
+    if isinstance(item, (bool, type(None))):
+        return 1
+    if isinstance(item, (list, tuple, set, frozenset)):
+        if len(item) == 0:
+            return 0
+        # Check for circular references
+        item_id = id(item)
