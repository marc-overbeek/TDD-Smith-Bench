+def generate_issue_title(pkg: str, remediation: Dict[str, Any]) ->str:
+    from safety.models import is_pinned_requirement
+    from packaging.specifiers import SpecifierSet
+    
+    specifier = remediation['requirement']['specifier']
+    pinned = is_pinned_requirement(SpecifierSet(specifier))
+    
+    if pinned:
+        # For pinned requirements, show the full specifier like "==2.21.0"
+        return f'Security Vulnerability in {pkg}{specifier}'
+    else:
+        # For unpinned requirements, show the specifier like ">=2.21.0,<2.22.0"
+        return f'Security Vulnerability in {pkg}{specifier}'
 
 
