+def read_requirements(fh: Any, resolve: bool=True) ->Generator[Package,
+    None, None]:
+    try:
+        parsed = parse(fh, filetypes.requirements_txt)
+    except Exception:
+        # If parsing fails, try to parse line by line
+        for line in fh:
+            line = line.strip()
+            if line and not line.startswith('#'):
+                try:
+                    req = SafetyRequirement(line)
+                    if req.name:
+                        yield Package(name=req.name, version=req.version, requirements=[req])
+                except Exception:
+                    continue
+        return
+    
+    for dep in parsed.dependencies:
+        if dep.is_vcs:
+            # Skip VCS dependencies for now
+            continue
+            
+        if dep.is_recursive:
+            if resolve:
+                # For recursive dependencies, we need to resolve them
+                for req in dep.requirements:
+                    if req.name:
+                        yield Package(name=req.name, version=req.version, requirements=[req])
+            else:
+                # For non-resolved recursive deps, skip them
+                continue
+        else:
+            # Regular dependency
+            if dep.name:
+                yield Package(name=dep.name, version=dep.version, requirements=[dep])
 
 
