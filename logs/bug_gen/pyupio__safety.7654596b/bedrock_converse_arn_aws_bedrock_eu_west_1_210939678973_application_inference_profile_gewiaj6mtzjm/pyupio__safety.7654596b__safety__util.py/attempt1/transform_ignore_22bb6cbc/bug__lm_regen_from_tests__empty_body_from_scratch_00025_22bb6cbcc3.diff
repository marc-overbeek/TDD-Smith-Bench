+def transform_ignore(ctx: click.Context, param: click.Parameter, value:
+    Tuple[str]) ->Dict[str, Dict[str, Optional[str]]]:
+    if not value:
+        return {}
+    
+    result = {}
+    for item in value:
+        if ',' in item:
+            ids = item.split(',')
+        else:
+            ids = [item]
+        
+        for vid in ids:
+            vid = vid.strip()
+            if vid:
+                result[vid] = {'expires': None, 'reason': ''}
+    
+    return result
 
 
