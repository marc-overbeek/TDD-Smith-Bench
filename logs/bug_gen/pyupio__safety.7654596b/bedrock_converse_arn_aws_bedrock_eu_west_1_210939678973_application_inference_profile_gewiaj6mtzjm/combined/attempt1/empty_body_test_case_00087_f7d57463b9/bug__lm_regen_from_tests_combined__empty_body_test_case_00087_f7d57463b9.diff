+def review(*, report: Optional[Dict[str, Any]]=None, params: Optional[Dict[
+    str, Any]]=None) ->tuple:
+    if report is None:
+        raise ValueError("report is required")
+    
+    vulns = []
+    remediations = {}
+    packages = {}
+    
+    for pkg_name, pkg_data in report.get('packages', {}).items():
+        pkg = Package(
+            name=pkg_name,
+            version=pkg_data.get('version'),
+            requirements=[],
+            found=None,
+            insecure_versions=[],
+            secure_versions=[],
+            latest_version=None,
+            latest_version_without_known_vulnerabilities=None,
+            more_info_url=pkg_data.get('more_info_url')
+        )
+        packages[pkg_name] = pkg
+        
+        for vuln_data in pkg_data.get('vulnerabilities', []):
+            vuln = Vulnerability(
+                vulnerability_id=vuln_data.get('id'),
+                package_name=pkg_name,
+                pkg=pkg,
+                ignored=False,
+                ignored_reason=None,
+                ignored_expires=None,
+                vulnerable_spec=set(),
+                all_vulnerable_specs=[],
+                analyzed_version=None,
+                analyzed_requirement=None,
+                advisory=vuln_data.get('advisory'),
+                is_transitive=vuln_data.get('transitive', False),
+                published_date=vuln_data.get('published_date'),
+                fixed_versions=vuln_data.get('fixed_versions', []),
+                closest_versions_without_known_vulnerabilities=vuln_data.get('closest_secure_versions', []),
+                resources=vuln_data.get('resources'),
+                CVE=None,
+                severity=None,
+                affected_versions=vuln_data.get('affected_versions', []),
+                more_info_url=vuln_data.get('more_info_url')
+            )
+            vulns.append(vuln)
+            
+        if 'remediation' in pkg_data:
+            remediations[pkg_name] = pkg_data['remediation']
+    
+    return vulns, remediations, list(packages.values())
 
 
