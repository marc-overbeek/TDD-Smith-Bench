+def build_json_report(announcements: List[Dict], vulnerabilities: List[Dict
+    ], remediations: Dict[str, Any], packages: List[Any]) ->Dict[str, Any]:
+    report_meta = get_report_brief_info(as_dict=True)
+    
+    # Build scanned_packages dictionary
+    scanned_packages = {}
+    for package in packages:
+        pkg_dict = {
+            'name': package.name,
+            'version': package.version,
+            'requirements': [req.to_dict() if hasattr(req, 'to_dict') else {'raw': str(req), 'extras': [], 'marker': None, 'name': getattr(req, 'name', None), 'specifier': getattr(req, 'specifier', None), 'url': None, 'found': None} for req in package.requirements]
+        }
+        scanned_packages[package.name] = pkg_dict
+    
+    # Build affected_packages dictionary (only packages with vulnerabilities)
+    affected_packages = {}
+    for vuln in vulnerabilities:
+        pkg = vuln.get('pkg') or vuln.get('package')
+        if pkg and pkg.name not in affected_packages:
+            pkg_dict = {
+                'name': pkg.name,
+                'version': pkg.version,
+                'requirements': [req.to_dict() if hasattr(req, 'to_dict') else {'raw': str(req), 'extras': [], 'marker': None, 'name': getattr(req, 'name', None), 'specifier': getattr(req, 'specifier', None), 'url': None, 'found': None} for req in pkg.requirements],
+                'found': None,
+                'insecure_versions': pkg.insecure_versions,
+                'secure_versions': pkg.secure_versions,
+                'latest_version_without_known_vulnerabilities': pkg.latest_version_without_known_vulnerabilities,
+                'latest_version': pkg.latest_version,
+                'more_info_url': pkg.more_info_url
+            }
+            affected_packages[pkg.name] = pkg_dict
+    
+    # Build remediations structure
+    remediations_output = {}
+    for pkg_name, remediation_data in remediations.items():
+        remediations_output[pkg_name] = {
+            'requirements': remediation_data.get('requirements', {}),
+            'current_version': remediation_data.get('current_version', None),
+            'vulnerabilities_found': remediation_data.get('vulnerabilities_found', None),
+            'recommended_version': remediation_data.get('recommended_version', None),
+            'other_recommended_versions': remediation_data.get('other_recommended_versions', []),
+            'more_info_url': remediation_data.get('more_info_url', None)
+        }
+    
+    report = {
+        'report_meta': report_meta,
+        'scanned_packages': scanned_packages,
+        'affected_packages': affected_packages,
+        'announcements': get_basic_announcements(announcements),
+        'vulnerabilities': vulnerabilities,
+        'ignored_vulnerabilities': [],
+        'remediations': remediations_output,
+        'remediations_results': {
+            'vulnerabilities_fixed': [],
+            'remediations_applied': {},
+            'remediations_skipped': {}
+        }
     }
+    
+    return report
 
 
