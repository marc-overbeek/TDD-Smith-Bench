+def build_json_report(announcements: List[Dict], vulnerabilities: List[Dict], remediations: Dict[str, Any], packages: List[Any]) ->Dict[str, Any]:
+    report = get_report_brief_info(as_dict=True)
+    
+    scanned_packages = {}
+    for package in packages:
+        scanned_packages[package.name] = {
+            'name': package.name,
+            'version': package.version,
+            'requirements': [req.to_dict() for req in package.requirements]
+        }
+    
+    affected_packages = {}
+    for vuln in vulnerabilities:
+        pkg = vuln.get('pkg')
+        if pkg and pkg.name not in affected_packages:
+            affected_packages[pkg.name] = {
+                'name': pkg.name,
+                'version': pkg.version,
+                'requirements': [req.to_dict() for req in pkg.requirements],
+                'found': None,
+                'insecure_versions': pkg.insecure_versions,
+                'secure_versions': pkg.secure_versions,
+                'latest_version_without_known_vulnerabilities': pkg.latest_version_without_known_vulnerabilities,
+                'latest_version': pkg.latest_version,
+                'more_info_url': pkg.more_info_url
+            }
+    
+    remediations_data = {}
+    for package_name, remediation_info in remediations.items():
+        remediations_data[package_name] = {
+            'requirements': remediation_info.get('requirements', {}),
+            'current_version': remediation_info.get('current_version'),
+            'vulnerabilities_found': remediation_info.get('vulnerabilities_found'),
+            'recommended_version': remediation_info.get('recommended_version'),
+            'other_recommended_versions': remediation_info.get('other_recommended_versions', []),
+            'more_info_url': remediation_info.get('more_info_url')
+        }
+    
+    template = {
+        'report_meta': report,
+        'scanned_packages': scanned_packages,
+        'affected_packages': affected_packages,
+        'announcements': get_basic_announcements(announcements),
+        'vulnerabilities': vulnerabilities,
+        'ignored_vulnerabilities': [],
+        'remediations': remediations_data,
+        'remediations_results': {
+            'vulnerabilities_fixed': [],
+            'remediations_applied': {},
+            'remediations_skipped': {}
+        }
     }
+    
+    return template
 
 
