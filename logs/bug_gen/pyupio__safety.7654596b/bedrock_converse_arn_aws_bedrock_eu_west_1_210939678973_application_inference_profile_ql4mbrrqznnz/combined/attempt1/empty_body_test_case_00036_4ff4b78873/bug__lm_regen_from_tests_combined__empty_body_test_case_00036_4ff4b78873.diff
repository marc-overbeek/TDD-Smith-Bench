+def get_basic_announcements(announcements: List[Dict[str, Any]],
+    include_local: bool=True) ->List[Dict[str, Any]]:
+    basic = []
+    for announcement in announcements:
+        ann_type = announcement.get('type', '').lower()
+        if ann_type != 'primary_announcement':
+            basic.append(announcement)
+    
+    if include_local:
+        local = SafetyContext().local_announcements
+        if local:
+            basic.extend(local)
+    
+    return basic
 
 
