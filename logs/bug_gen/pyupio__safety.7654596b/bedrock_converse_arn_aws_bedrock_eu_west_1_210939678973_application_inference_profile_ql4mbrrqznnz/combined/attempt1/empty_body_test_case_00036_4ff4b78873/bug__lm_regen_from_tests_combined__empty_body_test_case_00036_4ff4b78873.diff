+def build_telemetry_data(telemetry: bool=True, command: Optional[str]=None,
+    subcommand: Optional[str]=None) ->TelemetryModel:
+    ctx = SafetyContext()
+    
+    if command is None:
+        command = ctx.command
+    if subcommand is None:
+        subcommand = ctx.subcommand
+    
+    python_version = platform.python_version()
+    safety_command = command
+    safety_version = get_safety_version()
+    
+    try:
+        used_options = get_used_options()
+    except Exception:
+        used_options = {}
+    
+    return TelemetryModel(
+        telemetry=telemetry,
+        safety_version=safety_version,
+        python_version=python_version,
+        safety_command=safety_command,
+        safety_subcommand=subcommand,
+        used_options=used_options,
+    )
 
 
