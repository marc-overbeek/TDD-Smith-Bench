+def get_flags_from_context() ->Dict[str, str]:
+    try:
+        ctx = click.get_current_context()
+        flags = {}
+        for param in ctx.command.params:
+            for opt in param.opts:
+                flags[opt] = param.name
+        return flags
+    except Exception:
+        return {}
+
+
+def get_used_options() ->Dict[str, Dict[str, int]]:
+    try:
+        flags = get_flags_from_context()
+    except Exception:
+        flags = {}
+
+    used_options: Dict[str, Dict[str, int]] = {}
+
+    argv = sys.argv[1:]
+
+    for arg in argv:
+        if arg.startswith('-'):
+            key_part = arg.split('=')[0]
+            if key_part in flags:
+                option_name = flags[key_part]
+                if option_name not in used_options:
+                    used_options[option_name] = {}
+                used_options[option_name][key_part] = used_options[option_name].get(key_part, 0) + 1
 
     return used_options
 
 
