+    
+    if is_supported_by_parser(path):
+        content = fh.read()
+        df = parse(content, file_type=path)
+        for dep in df.dependencies:
+            if dep.name:
+                name = canonicalize_name(dep.name)
+                req = parse_requirement(dep, found=path)
