+                        latest_version=None,
+                        latest_version_without_known_vulnerabilities=None,
+                        more_info_url=None
+                    )
+                else:
+                    packages[name].requirements.append(req)
+        
+        for dep in df.resolved_dependencies if hasattr(df, 'resolved_dependencies') else []:
+            pass
+    else:
+        content = fh.read()
+        if hasattr(content, 'decode'):
+            content = content.decode('utf-8')
+        
+        for line in content.splitlines():
