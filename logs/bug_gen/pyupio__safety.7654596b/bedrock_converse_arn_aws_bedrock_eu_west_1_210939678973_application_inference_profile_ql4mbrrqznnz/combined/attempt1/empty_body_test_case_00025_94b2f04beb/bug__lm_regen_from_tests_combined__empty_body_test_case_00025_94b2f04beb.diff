+def transform_ignore(ctx: click.Context, param: click.Parameter, value:
+    Tuple[str]) ->Dict[str, Dict[str, Optional[str]]]:
+    
+    result = {}
+    
+    if not value:
+        return result
+    
+    for item in value:
+        ids = [i.strip() for i in item.split(',') if i.strip()]
+        for vuln_id in ids:
+            result[vuln_id] = {'expires': None, 'reason': ''}
+    
+    return result
 
 
