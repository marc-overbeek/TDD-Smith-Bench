+    # get the error that we're formatting
+    error = root_error
+    # get the error's scope
+    error_scope = error._scope
+    # get the error's path
+    error_path = error.path if hasattr(error, 'path') else None
+
+    # now we walk the stack to find the error's scope
+    # and build up the trace
+    for i, (cur_scope, cur_spec, cur_target, cur_error, cur_child_errors) in enumerate(stack):
