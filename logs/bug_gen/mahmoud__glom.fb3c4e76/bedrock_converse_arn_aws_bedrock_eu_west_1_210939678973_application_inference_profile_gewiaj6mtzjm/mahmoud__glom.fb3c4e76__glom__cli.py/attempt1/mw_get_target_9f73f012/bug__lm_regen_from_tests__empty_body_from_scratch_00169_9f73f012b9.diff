+def mw_get_target(next_, posargs_, target_file, target_format, spec_file,
+    spec_format):
+    # Handle positional arguments
+    spec_arg = None
+    target_arg = None
+    if posargs_:
+        spec_arg = posargs_[0]
+        if len(posargs_) > 1:
+            target_arg = posargs_[1]
+    
+    # Handle spec from file or argument
+    if spec_file:
+        with open(spec_file, 'r') as f:
+            spec_text = f.read()
+        if spec_format == 'python':
+            spec = ast.literal_eval(spec_text)
+        elif spec_format == 'json':
+            spec = json.loads(spec_text)
+        elif spec_format == 'python-full':
+            spec = _eval_python_full_spec(spec_text)
+        else:
+            raise UsageError('expected spec-format to be one of python, json, or python-full')
+    else:
+        if spec_arg is None:
+            # Default to empty dict when no spec provided
+            spec = {}
+        else:
+            spec = spec_arg
+    
+    # Handle target from file, stdin, or argument
+    if target_file:
+        with open(target_file, 'r') as f:
+            target_text = f.read()
+        target = mw_handle_target(target_text, target_format)
