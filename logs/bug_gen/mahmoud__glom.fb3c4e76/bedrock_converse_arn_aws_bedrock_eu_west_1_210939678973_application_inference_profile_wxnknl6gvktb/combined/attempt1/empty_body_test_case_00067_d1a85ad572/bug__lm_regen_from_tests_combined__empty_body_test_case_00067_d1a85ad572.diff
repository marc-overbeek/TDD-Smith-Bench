+def format_target_spec_trace(scope, root_error, width=TRACE_WIDTH, depth=0,
+    prev_target=_MISSING, last_branch=True):
+    lines = []
+    stack = _unpack_stack(scope, only_errors=True)
+    
+    for i, (cur_scope, spec, target, error, child_errors) in enumerate(stack):
+        is_last = (i == len(stack) - 1)
+        
+        if target is not _MISSING and target != prev_target:
+            prefix = ' - ' if last_branch else ' | '
+            target_repr = _format_trace_value(target, width - len(prefix) - 10)
+            lines.append(f'{prefix}Target: {target_repr}')
+            prev_target = target
+        
+        if spec is not _MISSING:
+            prefix = ' - ' if last_branch else ' | '
+            if child_errors and not is_last:
+                prefix = ' + '
+            spec_repr = _format_trace_value(spec, width - len(prefix) - 10)
+            lines.append(f'{prefix}Spec: {spec_repr}')
+        
+        if child_errors and is_last:
+            for j, child_scope in enumerate(child_errors):
+                is_last_child = (j == len(child_errors) - 1)
+                child_error = child_scope.get(CUR_ERROR, _MISSING)
+                if child_error is not _MISSING:
+                    prefix = ' |\\ ' if not is_last_child else ' |\\ '
+                    error_repr = _format_trace_value(child_error, width - len(prefix) - 10)
+                    lines.append(f'{prefix}Spec: {error_repr}')
+                    prefix = ' |X ' if not is_last_child else ' |X '
+                    lines.append(f'{prefix}{type(child_error).__name__}: {child_error.get_message() if hasattr(child_error, "get_message") else str(child_error)}')
+    
+    return '\n'.join(lines)
 
 
