+    year, month, day, hour, minute, second = (int(m.group(i)) for i in range(1, 7))
+    microsecond = 0
+    if m.group(7):
+        frac = m.group(7)[1:]
+        frac = frac[:6]
+        frac = frac.ljust(6, '0')
+        microsecond = int(frac)
+    tz_str = m.group(8)
+    if tz_str is None:
+        tzinfo = None
+    elif tz_str == 'Z':
+        tzinfo = SimpleTZ()
+    else:
+        tzinfo = SimpleTZ(tz_str)
+    return mod_datetime.datetime(year, month, day, hour, minute, second, microsecond, tzinfo=tzinfo)
+
+
+def format_time(time: mod_datetime.datetime) ->str:
+    if not time:
+        return ''
+    tzinfo = time.tzinfo
+    if tzinfo is None:
+        tz_str = ''
+    else:
+        offset = tzinfo.utcoffset(time)
+        total_seconds = int(offset.total_seconds())
+        if total_seconds == 0:
+            tz_str = 'Z'
+        else:
+            sign = '+' if total_seconds >= 0 else '-'
+            total_seconds = abs(total_seconds)
+            hours = total_seconds // 3600
+            minutes = (total_seconds % 3600) // 60
+            tz_str = f'{sign}{hours:02d}:{minutes:02d}'
+    if time.microsecond:
+        return time.strftime(f'%Y-%m-%dT%H:%M:%S.{time.microsecond:06d}{tz_str}')
+    return time.strftime(f'%Y-%m-%dT%H:%M:%S{tz_str}')
 
 
 
