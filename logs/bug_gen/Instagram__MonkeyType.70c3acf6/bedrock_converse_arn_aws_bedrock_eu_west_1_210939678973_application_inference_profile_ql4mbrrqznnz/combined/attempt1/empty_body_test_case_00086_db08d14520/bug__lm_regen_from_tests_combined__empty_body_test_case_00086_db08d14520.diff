+def shrink_typed_dict_types(typed_dicts: List[type], max_typed_dict_size: int
+    ) ->type:
+    all_keys = set()
+    for td in typed_dicts:
+        required, optional = field_annotations(td)
+        all_keys.update(required.keys())
+        all_keys.update(optional.keys())
+    
+    required_fields = {}
+    optional_fields = {}
+    
+    for key in all_keys:
+        key_types = []
+        present_count = 0
+        for td in typed_dicts:
+            req, opt = field_annotations(td)
+            if key in req:
+                key_types.append(req[key])
+                present_count += 1
+            elif key in opt:
+                key_types.append(opt[key])
+                present_count += 1
+        
+        merged = shrink_types(key_types, max_typed_dict_size)
+        
+        if present_count == len(typed_dicts):
+            required_fields[key] = merged
+        else:
+            optional_fields[key] = merged
+    
+    total_size = len(required_fields) + len(optional_fields)
+    if max_typed_dict_size == 0 or total_size > max_typed_dict_size:
+        all_value_types = list(required_fields.values()) + list(optional_fields.values())
+        if not all_value_types:
+            return Dict[Any, Any]
+        return Dict[str, Union[tuple(all_value_types)] if len(all_value_types) > 1 else all_value_types[0]]
+    
+    return make_typed_dict(required_fields=required_fields, optional_fields=optional_fields)
 
 
