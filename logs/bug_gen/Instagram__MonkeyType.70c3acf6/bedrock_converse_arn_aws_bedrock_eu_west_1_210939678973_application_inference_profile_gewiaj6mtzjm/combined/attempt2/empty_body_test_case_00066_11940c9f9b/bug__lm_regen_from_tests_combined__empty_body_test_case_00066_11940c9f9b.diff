+def render_signature(sig: inspect.Signature, max_line_len: Optional[int]=
+    None, prefix: str='') ->str:
+    if max_line_len is None:
+        max_line_len = 120
+    params = [render_parameter(p) for p in sig.parameters.values()]
+    if len(params) == 0:
+        return "()"
+    if len(", ".join(params)) < max_line_len - len(prefix) - 4:
+        return "(%s)" % (", ".join(params),)
+    else:
+        indented = [f"{prefix}    {p}" for p in params]
+        return "(\n%s\n%s)" % (",\n".join(indented), prefix)
 
 
