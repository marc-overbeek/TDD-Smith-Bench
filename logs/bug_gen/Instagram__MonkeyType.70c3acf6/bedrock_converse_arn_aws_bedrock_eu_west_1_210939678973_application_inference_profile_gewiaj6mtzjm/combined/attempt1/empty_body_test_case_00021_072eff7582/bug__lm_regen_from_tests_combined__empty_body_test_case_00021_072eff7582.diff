+def get_monkeytype_config(path: str) ->Config:
+    if os.path.isfile(path):
+        # If the path points to a file, we need to make sure it's on the Python path
+        # so that we can import it as a module.
+        dir_path = os.path.dirname(path)
+        if dir_path not in sys.path:
+            sys.path.insert(0, dir_path)
+        module_name = os.path.splitext(os.path.basename(path))[0]
+        spec = importlib.util.spec_from_file_location(module_name, path)
+        module = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(module)
+        if hasattr(module, "monkeytype_config"):
+            return module.monkeytype_config
+    # Fall back to default config
+    from monkeytype.config import DefaultConfig
+    return DefaultConfig()
 
 
