+def render_signature(sig: inspect.Signature, max_line_len: Optional[int]=
+    None, prefix: str='') ->str:
+    """Render a signature, potentially splitting parameters across multiple lines."""
+    # Get the parameters as strings
+    param_strings = [render_parameter(p) for p in sig.parameters.values()]
+    
+    # If we have no parameters, just return the function signature
+    if not param_strings:
+        return '()'
+    
+    # If max_line_len is not specified, use a reasonable default
+    if max_line_len is None:
+        max_line_len = 120
+    
+    # Try to fit everything on one line
+    joined_params = ', '.join(param_strings)
+    if len(joined_params) <= max_line_len - len(prefix) - 4:  # account for "()" and prefix
+        return f"({joined_params})"
+    
+    # If that doesn't work, split parameters across multiple lines
+    indented_params = [f"{prefix}    {param}" for param in param_strings]
+    return f"(\n{',\n'.join(indented_params)}\n{prefix})"
 
 
