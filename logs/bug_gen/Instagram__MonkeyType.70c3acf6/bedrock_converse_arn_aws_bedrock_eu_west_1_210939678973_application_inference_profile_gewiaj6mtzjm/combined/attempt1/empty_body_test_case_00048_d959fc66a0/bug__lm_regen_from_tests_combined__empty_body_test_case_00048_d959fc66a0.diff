+def update_signature_return(sig: inspect.Signature, return_type: Optional[
+    type]=None, yield_type: Optional[type]=None,
+    existing_annotation_strategy: ExistingAnnotationStrategy=
+    ExistingAnnotationStrategy.REPLICATE) ->inspect.Signature:
+    if return_type is None and yield_type is None:
+        return sig
+
+    # Determine the new return annotation
+    new_return_annotation = sig.return_annotation
+    if return_type is not None:
+        new_return_annotation = return_type
+    if yield_type is not None:
+        if return_type is not None:
+            # Both return and yield types are specified
+            new_return_annotation = make_generator(yield_type, NoneType, return_type)
+        else:
+            # Only yield type is specified
+            new_return_annotation = make_iterator(yield_type)
+
+    # Handle existing annotation strategies
+    if existing_annotation_strategy == ExistingAnnotationStrategy.REPLICATE:
+        # Keep existing annotation if present
+        if sig.return_annotation is not inspect.Signature.empty:
+            new_return_annotation = sig.return_annotation
+    elif existing_annotation_strategy == ExistingAnnotationStrategy.IGNORE:
+        # Override with new annotation
+        pass
+    elif existing_annotation_strategy == ExistingAnnotationStrategy.OMIT:
+        # Omit annotation if there was one
+        if sig.return_annotation is not inspect.Signature.empty:
+            new_return_annotation = inspect.Signature.empty
+
+    return sig.replace(return_annotation=new_return_annotation)
 
 
