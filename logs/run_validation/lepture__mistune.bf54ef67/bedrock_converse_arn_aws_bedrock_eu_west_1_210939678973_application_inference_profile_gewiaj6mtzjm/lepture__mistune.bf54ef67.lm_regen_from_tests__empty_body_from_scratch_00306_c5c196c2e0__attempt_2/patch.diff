+def render_html_toc(renderer: 'BaseRenderer', title: str, collapse: bool=
+    False, **attrs: Any) ->str:
+    toc = attrs.get('toc', [])
+    if not toc:
+        return ''
+    
+    html = []
+    if title:
+        html.append(f'<h4>{title}</h4>')
+    
+    if collapse:
+        html.append('<details class="toc-details">')
+        html.append('<summary class="toc-summary">Table of Contents</summary>')
+    
+    html.append('<ul class="toc">')
+    for level, text, id_ in toc:
+        html.append(f'<li class="toc-level-{level}"><a href="#{id_}">{text}</a></li>')
+    html.append('</ul>')
+    
+    if collapse:
+        html.append('</details>')
+    
+    return '\n'.join(html)
 
 
