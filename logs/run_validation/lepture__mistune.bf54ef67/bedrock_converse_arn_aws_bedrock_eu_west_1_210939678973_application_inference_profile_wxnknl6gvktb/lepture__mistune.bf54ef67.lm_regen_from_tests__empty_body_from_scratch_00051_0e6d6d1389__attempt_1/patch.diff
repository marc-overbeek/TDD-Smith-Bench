+def parse_list(block: 'BlockParser', m: Match[str], state: 'BlockState') ->int:
+    """Parse a list (ordered or unordered)."""
+    marker = m.group('list_2')
+    
+    # Determine list type
+    if marker[0] in '+-*':
+        list_type = 'bullet_list'
+    else:
+        list_type = 'ordered_list'
+    
+    # Create list token
+    token: Dict[str, Any] = {
+        'type': list_type,
+        'children': [],
+        'tight': True,
+    }
+    
+    # Get parsing rules
+    rules = block.rules[:]
+    
+    # Parse first list item
+    groups = (m.group('list_1'), m.group('list_2'), m.group('list_3'))
+    next_group = _parse_list_item(block, marker, groups, token, state, rules)
+    
+    # Parse subsequent list items
+    while next_group:
+        next_group = _parse_list_item(block, marker, next_group, token, state, rules)
+    
+    # Transform tight lists
+    _transform_tight_list(token)
+    
     state.append_token(token)
     return state.cursor
 
