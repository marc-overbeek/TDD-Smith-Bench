+def render_html_toc(renderer: 'BaseRenderer', title: str, collapse: bool=
+    False, **attrs: Any) ->str:
+    toc = attrs.get('toc', [])
+    if not toc:
+        return ''
+    
+    html = '<div class="toc">\n'
+    if title:
+        html += f'<span class="toc-title">{title}</span>\n'
+    
+    if collapse:
+        html += '<details>\n<summary>Table of Contents</summary>\n'
+    
+    html += render_toc_ul(toc)
