+def normalize_toc_item(md: 'Markdown', token: Dict[str, Any]) ->Tuple[int,
+    str, str]:
+    level = token['attrs']['level']
+    heading_id = token['attrs']['id']
+    
+    # Extract text from token children
+    text = ''
+    if 'children' in token:
+        for child in token['children']:
+            if child['type'] == 'text':
+                text += child['raw']
+            elif child['type'] == 'codespan':
+                text += child['raw']
+            elif child['type'] == 'link':
+                # For links, extract text from children
+                if 'children' in child:
+                    for link_child in child['children']:
+                        if link_child['type'] == 'text':
+                            text += link_child['raw']
+            else:
+                # For other inline elements, try to get raw or render
+                if 'raw' in child:
+                    text += child['raw']
+    
+    # Strip any remaining HTML tags
+    text = striptags(text)
+    
+    return (level, heading_id, text)
