+def _parse_attrs(options: Dict[str, Any]) ->Dict[str, Any]:
+    attrs: Dict[str, Any] = {}
+    
+    if 'alt' in options:
+        attrs['alt'] = options['alt']
+    
+    for key in ['width', 'height']:
+        if key in options:
