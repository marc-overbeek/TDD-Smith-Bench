+def parse_inline_footnote(inline: 'InlineParser', m: Match[str], state:
+    'InlineState') ->int:
+    key = unikey(m.group('footnote_key'))
+    footnotes = state.env.get('footnotes', {})
+    if key not in footnotes:
+        footnotes[key] = None
+        state.env['footnotes'] = footnotes
+    index = list(footnotes.keys()).index(key) + 1
+    state.append_token({'type': 'footnote_ref', 'attrs': {'key': key, 'index': index}})
