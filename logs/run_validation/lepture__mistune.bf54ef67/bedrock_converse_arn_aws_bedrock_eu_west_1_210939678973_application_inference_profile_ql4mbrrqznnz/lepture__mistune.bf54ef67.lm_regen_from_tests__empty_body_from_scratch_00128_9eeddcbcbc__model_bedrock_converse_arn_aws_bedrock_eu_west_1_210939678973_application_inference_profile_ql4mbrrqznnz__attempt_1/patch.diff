+def parse_footnote_item(block: 'BlockParser', key: str, index: int, state:
+    BlockState) ->Dict[str, Any]:
+    ref = state.env.get('ref_footnotes')
+    text = ref[key]
+    
+    # Strip leading spaces from continuation lines
+    lines = text.splitlines()
+    new_lines = []
+    for line in lines:
+        if len(line) > 0 and line[0] == ' ':
+            # Remove up to 4 spaces of indentation
+            stripped = line.lstrip(' ')
+            removed = len(line) - len(stripped)
+            line = line[min(removed, 4):]
+        new_lines.append(line)
+    text = '\n'.join(new_lines)
+    
+    child_state = BlockState()
+    child_state.process(text)
+    block.parse(child_state)
+    
+    children = child_state.tokens
+    
+    return {
+        'type': 'footnote_item',
+        'children': children,
+        'attrs': {'key': key, 'index': index},
     }
 
 
