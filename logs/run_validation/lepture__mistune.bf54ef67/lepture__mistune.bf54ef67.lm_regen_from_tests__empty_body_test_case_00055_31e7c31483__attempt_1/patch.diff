+def parse_block_spoiler(block: 'BlockParser', m: Match[str], state:
+    'BlockState') ->int:
+    pos = m.end()
+    text = m.group(0)
+    while pos < len(state.src):
+        next_line_match = _BLOCK_SPOILER_START.match(state.src, pos)
+        if not next_line_match:
+            break
+        line_end = state.src.find('\n', pos)
+        if line_end == -1:
+            line_end = len(state.src)
+        text += state.src[pos:line_end + 1]
+        pos = line_end + 1
+    
+    text = _BLOCK_SPOILER_START.sub('', text)
+    state.append_token({'type': 'block_spoiler', 'raw': text})
+    return pos
 
 
