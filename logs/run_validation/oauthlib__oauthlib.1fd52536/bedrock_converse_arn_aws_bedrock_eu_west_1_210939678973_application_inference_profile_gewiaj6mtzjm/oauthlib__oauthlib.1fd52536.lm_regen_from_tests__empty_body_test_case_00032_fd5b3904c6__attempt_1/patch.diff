-    #     separator.
-    return '&'.join(parameter_parts)
+def normalize_parameters(params) ->str:
+    # Sort parameters by key, then by value
+    sorted_params = sorted(params, key=lambda x: (x[0], x[1]))
+    
+    # Encode each parameter and join with &
+    encoded_pairs = []
+    for key, value in sorted_params:
+        encoded_key = utils.escape(key)
+        encoded_value = utils.escape(value)
+        encoded_pairs.append(f"{encoded_key}={encoded_value}")
+    
+    return "&".join(encoded_pairs)
 
 
