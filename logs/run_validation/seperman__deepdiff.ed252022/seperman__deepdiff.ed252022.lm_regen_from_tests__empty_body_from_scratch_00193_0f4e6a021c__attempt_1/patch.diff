+    def test_datetime_hash(self):
+        dt_utc = datetime.datetime(2025, 2, 3, 12, 0, 0, tzinfo=pytz.utc)
+        dt_ny = dt_utc.astimezone(pytz.timezone('America/New_York'))
+        assert dt_utc == dt_ny
+        result_utc = DeepHash(dt_utc, ignore_string_type_changes=True, hasher=
+            DeepHash.sha1hex)
+        result_ny = DeepHash(dt_ny, ignore_string_type_changes=True, hasher=
+            DeepHash.sha1hex)
+        assert result_utc[dt_utc] == result_ny[dt_ny]
