+def build_json_report(announcements: List[Dict], vulnerabilities: List[Dict
+    ], remediations: Dict[str, Any], packages: List[Any]) ->Dict[str, Any]:
+    ignored_vulnerabilities = [v for v in vulnerabilities if v.ignored]
+    active_vulnerabilities = [v for v in vulnerabilities if not v.ignored]
+    
+    affected_packages = {}
+    for vuln in vulnerabilities:
+        pkg = vuln.pkg
+        if pkg.name not in affected_packages:
+            affected_packages[pkg.name] = pkg
+    
+    scanned_packages = {}
+    for pkg in packages:
+        scanned_packages[pkg.name] = pkg
+    
+    report = get_report_brief_info(as_dict=True, report_type=1,
+                                   vulnerabilities_found=len(active_vulnerabilities),
+                                   vulnerabilities_ignored=len(ignored_vulnerabilities),
+                                   remediations_recommended=len(remediations.keys()))
+    
+    formatted_remediations = {}
+    for pkg_name, req_remediations in remediations.items():
+        formatted_remediations[pkg_name] = {
+            'requirements': req_remediations,
+            'current_version': None,
+            'vulnerabilities_found': None,
+            'recommended_version': None,
+            'other_recommended_versions': [],
+            'more_info_url': None
+        }
+    
+    template = {
+        'report_meta': report,
+        'scanned_packages': scanned_packages,
+        'affected_packages': affected_packages,
+        'announcements': get_basic_announcements(announcements),
+        'vulnerabilities': active_vulnerabilities,
+        'ignored_vulnerabilities': ignored_vulnerabilities,
+        'remediations': formatted_remediations,
     }
+    
+    return template
 
 
