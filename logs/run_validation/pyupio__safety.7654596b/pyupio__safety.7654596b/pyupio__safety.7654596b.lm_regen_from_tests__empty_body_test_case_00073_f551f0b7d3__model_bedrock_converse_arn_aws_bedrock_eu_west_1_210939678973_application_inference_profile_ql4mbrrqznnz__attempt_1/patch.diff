+def get_closest_ver(versions: List[str], version: Optional[str], spec:
+    SpecifierSet) ->Dict[str, Optional[Union[str, Version]]]:
+    result = {'lower': None, 'upper': None}
+    
+    if not version or spec is None:
+        return result
+    
+    if not versions:
+        return result
+    
+    current = parse_version(version)
+    parsed_versions = sorted([parse_version(v) for v in versions])
+    
+    lower = None
+    upper = None
+    
+    for v in parsed_versions:
+        if v < current:
+            lower = v
+        elif v > current:
+            if upper is None:
+                upper = v
+    
+    result['lower'] = lower
+    result['upper'] = upper
+    
+    return result
+
