+            result_lines.extend(wrap_line(sev_line))
+
+            if cvssv2:
+                base_score_v2 = cvssv2.get('base_score', '')
+                impact_score_v2 = cvssv2.get('impact_score', '')
+                vector_v2 = cvssv2.get('vector_string', '')
+                result_lines.extend(wrap_line(f'{indent}CVSS v2, BASE SCORE {base_score_v2}, IMPACT SCORE {impact_score_v2}, VECTOR STRING {vector_v2}'))
+
+        if not is_pinned:
+            result_lines.extend(wrap_line(f'{indent}This vulnerability is present in your install specifier range.'))
+            result_lines.extend(wrap_line(f'{indent}To learn more about reporting these, specifier range handling, and options for scanning unpinned packages visit'))
+            result_lines.extend(wrap_line(f'{indent}https://docs.pyup.io/docs/safety-range-specs'))
+
+        more_info_url = getattr(vulnerability, 'more_info_url', '')
