+def format_vulnerability(vulnerability: Any, full_mode: bool, only_text:
+    bool=False, columns: int=get_terminal_size().columns) ->str:
+    pkg = vulnerability.pkg
+    requirements = pkg.requirements if pkg.requirements else []
+    
+    is_pinned = True
+    req_spec = None
+    if requirements:
+        req = requirements[0]
+        is_pinned = is_pinned_requirement(req)
+        req_spec = str(req.specifier) if hasattr(req, 'specifier') else None
+
+    indent = '   '
+    result_lines = []
+
+    def wrap_line(text, initial='', subsequent=indent):
+        return textwrap.wrap(text, width=columns, initial_indent=initial, subsequent_indent=subsequent)
+
+    if is_pinned:
+        result_lines.extend(wrap_line(f'-> Vulnerability found in {pkg.name} version {pkg.version}', initial='', subsequent=indent))
+    else:
+        spec_str = req_spec if req_spec else ''
+        result_lines.extend(wrap_line(f'-> Vulnerability may be present given that your {pkg.name} install specifier is', initial='', subsequent=indent))
+        result_lines.extend(wrap_line(f'{indent}{spec_str}', initial='', subsequent=indent))
+
+    result_lines.extend(wrap_line(f'{indent}Vulnerability ID: {vulnerability.vulnerability_id}'))
+
+    ignored_expires = getattr(vulnerability, 'ignored_expires', None)
+    ignored_reason = getattr(vulnerability, 'ignored_reason', None)
+
+    if vulnerability.ignored:
+        if ignored_expires:
+            expires_str = ignored_expires.strftime('%Y-%m-%d %H:%M:%S') + ' UTC'
+            result_lines.extend(wrap_line(f'{indent}This vulnerability is being ignored until {expires_str}. See your configurations.'))
+        else:
+            result_lines.extend(wrap_line(f'{indent}This vulnerability is being ignored.'))
+
+        if ignored_reason:
+            result_lines.extend(wrap_line(f'{indent}Reason: {ignored_reason}'))
+
+        more_info_url = getattr(vulnerability, 'more_info_url', '')
+        result_lines.extend(wrap_line(f'{indent}For more information about this vulnerability, visit {more_info_url}'))
+    else:
+        result_lines.extend(wrap_line(f'{indent}Affected spec: {vulnerability.vulnerable_spec}'))
+        result_lines.extend(wrap_line(f'{indent}ADVISORY: {vulnerability.advisory}'))
+
+        secure_versions = pkg.secure_versions if pkg.secure_versions else []
+        if secure_versions:
+            result_lines.extend(wrap_line(f'{indent}Fixed versions: {", ".join(secure_versions)}'))
+        else:
+            result_lines.extend(wrap_line(f'{indent}Fixed versions: No known fix'))
+
+        cve = vulnerability.cve
+        if cve and hasattr(cve, 'cvssv3') and cve.cvssv3:
+            cvssv3 = cve.cvssv3
+            cvssv2 = cve.cvssv2 if hasattr(cve, 'cvssv2') and cve.cvssv2 else None
+            severity = cvssv3.get('base_severity', '')
+            base_score_v3 = cvssv3.get('base_score', '')
+            impact_score_v3 = cvssv3.get('impact_score', '')
