+@sync_safety_context
+def review(*, report: Optional[Dict[str, Any]]=None, params: Optional[Dict[
+    str, Any]]=None) ->tuple:
+    SafetyContext().command = 'review'
+    
+    if not report:
+        return [], {}, []
+    
+    vulns = []
+    remediations = defaultdict(dict)
+    packages = {}
+    
+    report_packages = report.get('scanned_packages', {})
+    
+    for pkg_name, pkg_data in report_packages.items():
+        name = pkg_data.get('name', pkg_name)
+        version = pkg_data.get('version', None)
+        req_str = f"{name}=={version}" if version else name
+        try:
+            req = SafetyRequirement(req_str)
+        except Exception:
+            req = SafetyRequirement(name)
+        
+        pkg = Package(
+            name=name,
+            version=version,
+            requirements=[req],
+            found=pkg_data.get('found', None),
+            insecure_versions=[],
+            secure_versions=[],
+            latest_version=None,
+            latest_version_without_known_vulnerabilities=None,
+            more_info_url=None
+        )
+        packages[canonicalize_name(pkg_name)] = pkg
+    
+    report_vulns = report.get('vulnerabilities', [])
+    
+    for vuln_data in report_vulns:
+        pkg_name = vuln_data.get('package_name', '')
+        pkg = packages.get(canonicalize_name(pkg_name), None)
+        
+        analyzed_version = vuln_data.get('analyzed_version', None)
+        req_str = f"{pkg_name}=={analyzed_version}" if analyzed_version else pkg_name
+        
+        try:
+            analyzed_requirement = SafetyRequirement(req_str)
+        except Exception:
+            analyzed_requirement = SafetyRequirement(pkg_name)
+        
+        cve_data = vuln_data.get('CVE', None)
+        cve = None
+        if cve_data and isinstance(cve_data, dict) and cve_data.get('name'):
+            cve = CVE(name=cve_data.get('name', ''), cvssv2=cve_data.get('cvssv2'), cvssv3=cve_data.get('cvssv3'))
+        
+        severity = None
+        severity_data = vuln_data.get('severity', None)
+        if severity_data and isinstance(severity_data, dict):
+            severity = Severity(source=severity_data.get('source', ''), cvssv2=severity_data.get('cvssv2'), cvssv3=severity_data.get('cvssv3'))
+        
+        vuln = Vulnerability(
+            vulnerability_id=vuln_data.get('vulnerability_id', ''),
+            package_name=pkg_name,
+            pkg=pkg,
+            ignored=vuln_data.get('ignored', False),
+            ignored_reason=vuln_data.get('ignored_reason', None),
+            ignored_expires=vuln_data.get('ignored_expires', None),
+            vulnerable_spec=set(vuln_data.get('vulnerable_spec', [])),
+            all_vulnerable_specs=vuln_data.get('all_vulnerable_specs', []),
+            analyzed_version=analyzed_version,
+            analyzed_requirement=analyzed_requirement,
+            advisory=vuln_data.get('advisory', None),
+            is_transitive=vuln_data.get('is_transitive', False),
+            published_date=vuln_data.get('published_date', None),
+            fixed_versions=vuln_data.get('fixed_versions', []),
+            closest_versions_without_known_vulnerabilities=vuln_data.get('closest_versions_without_known_vulnerabilities', []),
+            resources=vuln_data.get('resources', []),
+            CVE=cve,
+            severity=severity,
+            affected_versions=vuln_data.get('affected_versions', []),
+            more_info_url=vuln_data.get('more_info_url', '')
+        )
+        vulns.append(vuln)
+        
+        spec_str = str(analyzed_requirement.specifier)
+        
+        if pkg_name not in remediations or spec_str not in remediations[pkg_name]:
+            remediations[pkg_name][spec_str] = {
+                'vulnerabilities_found': 1,
+                'version': analyzed_version,
+                'requirement': analyzed_requirement,
+                'more_info_url': vuln_data.get('more_info_url', '')
+            }
+        else:
+            remediations[pkg_name][spec_str]['vulnerabilities_found'] += 1
+    
+    # Overlay remediation data from report
+    report_remediations = report.get('remediations', {})
+    for pkg_name, pkg_rems in report_remediations.items():
+        for spec, rem_data in pkg_rems.items():
+            if pkg_name not in remediations:
+                remediations[pkg_name] = {}
+            if spec not in remediations[pkg_name]:
+                try:
+                    req = SafetyRequirement(f"{pkg_name}{spec}")
+                except Exception:
+                    req = SafetyRequirement(pkg_name)
+                remediations[pkg_name][spec] = {
+                    'vulnerabilities_found': rem_data.get('vulnerabilities_found', 0),
+                    'version': rem_data.get('version', None),
+                    'requirement': req,
+                    'more_info_url': rem_data.get('more_info_url', '')
+                }
+            
+            recommended_version_str = rem_data.get('recommended_version', None)
+            if recommended_version_str:
+                remediations[pkg_name][spec]['recommended_version'] = parse_version(recommended_version_str)
+            
+            other_recommended = rem_data.get('other_recommended_versions', [])
+            remediations[pkg_name][spec]['other_recommended_versions'] = other_recommended
+            
+            more_info_url = rem_data.get('more_info_url', '')
+            if more_info_url:
+                remediations[pkg_name][spec]['more_info_url'] = more_info_url
+            
+            vuln_found = rem_data.get('vulnerabilities_found', None)
+            if vuln_found is not None:
+                remediations[pkg_name][spec]['vulnerabilities_found'] = vuln_found
+    
+    return vulns, dict(remediations), list(packages.values())
 
 
