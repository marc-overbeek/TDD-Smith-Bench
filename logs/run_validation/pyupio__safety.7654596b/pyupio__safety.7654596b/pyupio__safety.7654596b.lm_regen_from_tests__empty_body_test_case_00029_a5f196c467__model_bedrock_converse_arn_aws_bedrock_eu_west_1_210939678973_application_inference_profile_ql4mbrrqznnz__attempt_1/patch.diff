+def build_announcements_section_content(announcements: List[Dict[str, Any]],
+    columns: int=get_terminal_size().columns, indent: str=' ' * 2,
+    sub_indent: str=' ' * 4) ->str:
+    content = ''
+    for announcement in announcements:
+        message = announcement.get('message', '')
+        content += format_long_text(f'* {message}', columns=columns,
+                                    start_line_decorator=indent,
+                                    end_line_decorator=indent,
+                                    sub_indent=sub_indent) + '\n'
+    return content
+
+
+def add_empty_line() ->str:
+    return '\n'
 
 
