+def get_flags_from_context() ->Dict[str, str]:
+    try:
+        ctx = click.get_current_context()
+        flags = {}
+        
+        def collect_params(context):
+            if context is None:
+                return
+            collect_params(context.parent)
+            if hasattr(context, 'command') and hasattr(context.command, 'params'):
+                for param in context.command.params:
+                    if isinstance(param, click.Option):
+                        for opt in param.opts:
+                            flags[opt] = param.name
+        
+        collect_params(ctx)
+        return flags
+    except RuntimeError:
+        return {}
+
+
+def get_used_options() ->Dict[str, Dict[str, int]]:
+    try:
+        flags = get_flags_from_context()
+    except Exception:
+        flags = {}
+    
+    used_options: Dict[str, Dict[str, int]] = defaultdict(dict)
+    
+    argv = sys.argv[1:]
+    
+    for arg in argv:
+        if arg.startswith('-'):
+            option = arg.split('=')[0]
+            if option in flags:
+                param_name = flags[option]
+                if option not in used_options[param_name]:
+                    used_options[param_name][option] = 0
+                used_options[param_name][option] += 1
+    
+    return dict(used_options)
+
+
+def get_safety_version() ->str:
+    try:
+        from importlib.metadata import version
+        return version('safety')
+    except Exception:
+        try:
+            import pkg_resources
+            return pkg_resources.get_distribution('safety').version
+        except Exception:
+            return 'unknown'
 
 
