+def read_requirements(fh: Any, resolve: bool=True) ->Generator[Package,
+    None, None]:
+    requirements = parse(fh.read(), file_type=filetypes.requirements_txt)
+    
+    for dep in requirements.dependencies:
+        found = canonicalize_name(dep.name)
+        
+        if dep.name.startswith('-e'):
+            continue
+        
+        specs = parse_requirement(dep, found)
+        
+        if resolve:
+            version = find_version([specs])
+        else:
+            version = None
+        
+        yield Package(
+            name=found,
+            version=version,
+            requirements=[specs] if specs else []
+        )
 
 
