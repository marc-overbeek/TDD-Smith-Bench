+    except RuntimeError:
+        pass
+    return {}
+
+
+def get_used_options() ->Dict[str, Dict[str, int]]:
+    try:
+        flags = get_flags_from_context()
+        if not flags:
+            return {}
+        
+        used_options = defaultdict(lambda: defaultdict(int))
+        
+        for i, arg in enumerate(sys.argv[1:]):
+            if arg.startswith('-'):
+                key = arg.split('=')[0]
+                if key in flags:
+                    param_name = flags[key]
+                    used_options[param_name][key] += 1
+            elif i > 0 and sys.argv[i].startswith('-'):
+                prev_key = sys.argv[i].split('=')[0]
+                if prev_key in flags:
+                    param_name = flags[prev_key]
+                    used_options[param_name][prev_key] += 1
+        
+        return {k: dict(v) for k, v in used_options.items()}
+    except Exception:
+        return {}
+
+
+def get_safety_version() ->str:
+    try:
+        from safety import __version__
+        return __version__
+    except Exception:
+        return "unknown"
 
 
