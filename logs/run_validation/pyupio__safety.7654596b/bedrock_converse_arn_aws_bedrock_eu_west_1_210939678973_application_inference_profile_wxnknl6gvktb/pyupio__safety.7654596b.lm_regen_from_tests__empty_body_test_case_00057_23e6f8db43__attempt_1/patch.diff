+def read_requirements(fh: Any, resolve: bool=True) ->Generator[Package,
+    None, None]:
+    requirements_file = RequirementFile.from_file(fh)
+    
+    for req in requirements_file.requirements:
+        name = canonicalize_name(req.name)
+        version = req.version
+        
+        if resolve:
+            requirements = [parse_requirement(req, found=req.name)]
+        else:
+            requirements = [parse_requirement(req, found=req.name)]
+        
+        if not version and resolve:
+            version = find_version(requirements)
+        
+        yield Package(
+            name=name,
+            version=version,
+            requirements=requirements
+        )
 
 
