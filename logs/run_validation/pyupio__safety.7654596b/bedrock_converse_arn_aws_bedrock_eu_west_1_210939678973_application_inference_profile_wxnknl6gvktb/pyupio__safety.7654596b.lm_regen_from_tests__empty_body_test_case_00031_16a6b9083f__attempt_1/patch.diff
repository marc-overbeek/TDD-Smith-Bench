+                            'lower': str(rem_info.get('closest_secure_version', {}).get('lower')) if rem_info.get('closest_secure_version', {}).get('lower') else None
+                        },
+                        'more_info_url': rem_info.get('more_info_url')
+                    }
+    
+    template = {
+        'report_meta': report,
+        'scanned_packages': scanned_packages,
+        'affected_packages': affected_packages,
+        'announcements': get_basic_announcements(announcements),
+        'vulnerabilities': vulnerabilities_list,
+        'ignored_vulnerabilities': ignored_vulnerabilities,
