+        if vuln_dict.get('ignored'):
+            ignored_vulnerabilities.append(vuln_dict)
+        else:
+            vulnerabilities_list.append(vuln_dict)
+    
+    remediations_dict = {}
+    for pkg_name, remediation_data in remediations.items():
+        remediations_dict[pkg_name] = {
+            'requirements': {},
+            'current_version': None,
+            'vulnerabilities_found': None,
+            'recommended_version': None,
+            'other_recommended_versions': [],
+            'more_info_url': None
+        }
+        
+        if isinstance(remediation_data, dict):
+            for spec, rem_info in remediation_data.items():
