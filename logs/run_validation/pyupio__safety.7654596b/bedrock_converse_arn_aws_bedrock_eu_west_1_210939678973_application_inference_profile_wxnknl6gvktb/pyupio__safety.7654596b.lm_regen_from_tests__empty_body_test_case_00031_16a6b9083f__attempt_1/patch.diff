+def build_json_report(announcements: List[Dict], vulnerabilities: List[Dict], remediations: Dict[str, Any], packages: List[Any]) ->Dict[str, Any]:
+    report = get_report_brief_info(as_dict=True)
+    
+    scanned_packages = {}
+    for package in packages:
+        scanned_packages[package.name] = {
+            'name': package.name,
+            'version': package.version,
+            'requirements': [req.to_dict() if hasattr(req, 'to_dict') else {'raw': str(req), 'extras': [], 'marker': None, 'name': getattr(req, 'name', None), 'specifier': getattr(req, 'specifier', None), 'url': None, 'found': None} for req in package.requirements]
+        }
+    
+    affected_packages = {}
+    for vuln in vulnerabilities:
+        pkg = vuln.get('pkg') or vuln.get('package')
+        if pkg and pkg.name not in affected_packages:
+            affected_packages[pkg.name] = {
+                'name': pkg.name,
+                'version': pkg.version,
+                'requirements': [req.to_dict() if hasattr(req, 'to_dict') else {'raw': str(req), 'extras': [], 'marker': None, 'name': getattr(req, 'name', None), 'specifier': getattr(req, 'specifier', None), 'url': None, 'found': None} for req in pkg.requirements],
+                'found': None,
+                'insecure_versions': pkg.insecure_versions,
+                'secure_versions': pkg.secure_versions,
+                'latest_version_without_known_vulnerabilities': pkg.latest_version_without_known_vulnerabilities,
+                'latest_version': pkg.latest_version,
+                'more_info_url': pkg.more_info_url
+            }
+    
+    vulnerabilities_list = []
+    ignored_vulnerabilities = []
+    
+    for vuln in vulnerabilities:
