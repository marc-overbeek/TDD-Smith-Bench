+def get_used_options() ->Dict[str, Dict[str, int]]:
+    ctx = click.get_current_context()
+    used_options = defaultdict(lambda: defaultdict(int))
+    for param in ctx.command.params:
+        if hasattr(param, 'opts') and param.opts:
+            for opt in param.opts:
+                if opt in ctx.params and ctx.params[opt] is not None:
+                    used_options[param.name][opt] += 1
+    return dict(used_options)
+
+
+def get_safety_version() ->str:
+    from safety import __version__
