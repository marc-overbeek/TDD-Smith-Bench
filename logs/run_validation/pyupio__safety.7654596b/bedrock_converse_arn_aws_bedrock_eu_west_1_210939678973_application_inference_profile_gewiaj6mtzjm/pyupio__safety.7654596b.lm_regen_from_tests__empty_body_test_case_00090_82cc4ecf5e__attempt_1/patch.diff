+def read_requirements(fh: Any, resolve: bool=True) ->Generator[Package,
+    None, None]:
+    try:
+        parsed = parse(fh.read(), dtype=filetypes.requirements_txt)
+    except Exception:
+        return
+        
+    if not parsed:
+        return
+        
+    for dep in parsed.dependencies:
+        if not dep:
+            continue
+            
+        if hasattr(dep, 'name') and dep.name:
+            name = dep.name
+        elif hasattr(dep, 'project_name') and dep.project_name:
+            name = dep.project_name
+        else:
+            continue
+            
+        if not hasattr(dep, 'specs') and not hasattr(dep, 'specifier'):
+            continue
+            
+        if hasattr(dep, 'specs'):
+            specs = dep.specs
+        else:
+            specs = dep.specifier
+            
+        if not specs:
+            continue
+            
+        if hasattr(dep, 'hashes') and dep.hashes:
+            hashes = dep.hashes
+            req = SafetyRequirement(f"{name}{specs}", hashes=hashes)
+        else:
+            req = SafetyRequirement(f"{name}{specs}")
+            
+        if resolve and hasattr(dep, 'requires') and dep.requires:
+            requirements = []
+            for r in dep.requires:
+                requirements.append(parse_requirement(r, found=name))
+            yield Package(name=name, version=None, requirements=requirements)
+        else:
+            yield Package(name=name, version=None, requirements=[req])
 
 
