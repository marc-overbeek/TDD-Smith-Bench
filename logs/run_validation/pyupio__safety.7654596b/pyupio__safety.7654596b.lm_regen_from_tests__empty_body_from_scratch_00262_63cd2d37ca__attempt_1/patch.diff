+def get_vulnerability_summary(report: Dict[str, Any]) ->Tuple[int, int]:
+    total_issues_with_duplicates = 0
+    total_ignored_issues = 0
+    
+    # Navigate through the report structure to find vulnerabilities
+    if isinstance(report, dict):
+        # Check if report has 'files' key (from ReportModel)
+        files = report.get('files', [])
+        if files:
+            for file_data in files:
+                if isinstance(file_data, dict):
+                    results = file_data.get('results', {})
+                    if isinstance(results, dict):
+                        # Get affected specifications
+                        affected_specs = results.get('affected_specifications', [])
+                        if affected_specs:
+                            for spec in affected_specs:
+                                if isinstance(spec, dict):
+                                    vulnerabilities = spec.get('vulnerabilities', [])
+                                    for vuln in vulnerabilities:
+                                        if isinstance(vuln, dict):
+                                            total_issues_with_duplicates += 1
+                                            if vuln.get('ignored', False):
+                                                total_ignored_issues += 1
+    
+    return total_issues_with_duplicates, total_ignored_issues
