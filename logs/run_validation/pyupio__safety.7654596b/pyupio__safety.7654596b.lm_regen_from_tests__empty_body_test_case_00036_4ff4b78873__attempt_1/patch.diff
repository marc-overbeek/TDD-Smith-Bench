+def get_basic_announcements(announcements: List[Dict[str, Any]],
+    include_local: bool=True) ->List[Dict[str, Any]]:
+    basic = [announcement for announcement in announcements 
+             if announcement.get('type', '').lower() in ('error', 'warning', 'notice')]
+    
+    if include_local:
+        ctx = SafetyContext()
+        if ctx.local_announcements:
+            basic.extend(ctx.local_announcements)
+    
+    return basic
 
 
