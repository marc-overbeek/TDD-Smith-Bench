+def get_flags_from_context() ->Dict[str, str]:
+    try:
+        ctx = click.get_current_context()
+        command = ctx.command
+        if command and hasattr(command, 'params'):
+            flags = {}
+            for param in command.params:
+                if isinstance(param, click.Option):
+                    for opt in param.opts:
+                        flags[opt] = param.name
+            return flags
+    except (RuntimeError, AttributeError):
+        pass
+    return {}
+
+
+def get_used_options() ->Dict[str, Dict[str, int]]:
+    try:
+        flags = get_flags_from_context()
+        used_options = defaultdict(lambda: defaultdict(int))
+        
+        for arg in sys.argv[1:]:
+            if arg.startswith('-'):
+                if '=' in arg:
+                    flag = arg.split('=')[0]
+                else:
+                    flag = arg
+                
+                if flag in flags:
+                    param_name = flags[flag]
+                    used_options[param_name][flag] += 1
+        
+        return {k: dict(v) for k, v in used_options.items()}
+    except Exception:
+        pass
+    return {}
+
+
+def get_safety_version() ->str:
+    try:
+        from safety import __version__
+        return __version__
+    except Exception:
+        return "unknown"
 
 
