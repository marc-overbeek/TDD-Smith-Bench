+def get_from_cache(db_name: str, cache_valid_seconds: int=0,
+    skip_time_verification: bool=False) ->Optional[Dict[str, Any]]:
+    cache_file = DB_CACHE_FILE
+    
+    if not os.path.exists(cache_file):
+        return None
+    
+    try:
+        lock_file = cache_file + '.lock'
+        with FileLock(lock_file, timeout=1):
+            if not os.path.exists(cache_file):
+                return None
+            
+            with open(cache_file, 'r') as f:
+                cache_data = json.load(f)
+            
+            if db_name not in cache_data:
+                return None
+            
+            cached_entry = cache_data[db_name]
+            
+            if skip_time_verification:
+                return cached_entry.get('data')
+            
+            timestamp = cached_entry.get('timestamp', 0)
+            current_time = time.time()
+            
+            if current_time - timestamp <= cache_valid_seconds:
+                return cached_entry.get('data')
+            
+            return None
+    except Exception as e:
+        LOG.debug(f'Error reading from cache: {e}')
+        return None
+
