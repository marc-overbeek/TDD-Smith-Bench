+def _model_stats_str(model: nn.Module, statistics: Dict[str, Dict[str, str]]
+    ) ->str:
+    """
+    Recursively builds a string representation of the model with statistics.
+    """
+    def _recursive_repr(module: nn.Module, prefix: str = "", indent: int = 0) -> str:
+        indent_str = "  " * indent
+        next_indent_str = "  " * (indent + 1)
+        
+        # Get module class name
+        module_repr = module.__class__.__name__ + "("
+        
+        # Get statistics for this module
+        mod_stats = statistics.get(prefix, {})
+        
+        # Get child modules
+        children = list(module.named_children())
+        
+        if not children:
+            # Leaf module
+            if mod_stats:
+                stats_str = ", ".join(f"{k}: {v}" for k, v in mod_stats.items())
+                module_repr += "\n" + next_indent_str + stats_str + "\n" + indent_str
+            module_repr += ")"
+            return indent_str + module_repr
+        else:
+            # Has children
+            lines = [indent_str + module_repr]
+            
+            # Add statistics
+            for stat_name, stat_val in mod_stats.items():
+                lines.append(next_indent_str + f"{stat_name}: {stat_val}")
+            
+            # Add children
+            for child_name, child_module in children:
+                child_prefix = prefix + ("." if prefix else "") + child_name
+                child_str = _recursive_repr(child_module, child_prefix, indent + 1)
+                lines.append(next_indent_str + f"({child_name}): {child_str.lstrip()}")
+            
+            lines.append(indent_str + ")")
+            return "\n".join(lines)
+    
+    return _recursive_repr(model, "", 0)
 
 
