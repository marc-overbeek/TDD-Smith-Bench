+def _get_param_shapes(model: nn.Module, module_name: str) -> str:
+    """
+    Get parameter shapes for a module, formatted as a string.
+    """
+    shapes = []
+    for name, param in model.named_parameters():
+        # Check if this parameter belongs to the module
+        if module_name == "":
+            # Root module - include all parameters
+            shapes.append(str(tuple(param.shape)))
+        elif name.startswith(module_name + "."):
+            # Check if it's a direct parameter of this module (not a submodule's parameter)
+            remainder = name[len(module_name) + 1:]
+            if "." not in remainder:
+                shapes.append(str(tuple(param.shape)))
+    
+    if shapes:
+        return ", ".join(shapes)
+    return ""
