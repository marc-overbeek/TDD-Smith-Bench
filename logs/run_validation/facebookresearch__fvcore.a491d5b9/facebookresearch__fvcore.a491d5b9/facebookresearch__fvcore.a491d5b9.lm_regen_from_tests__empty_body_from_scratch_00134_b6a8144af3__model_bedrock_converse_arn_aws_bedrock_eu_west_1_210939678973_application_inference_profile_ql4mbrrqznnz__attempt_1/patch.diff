+def _get_scoped_trace_graph(module: nn.Module, inputs: Union[Tensor, Tuple[
+    Tensor, ...]], aliases: Dict[Union[str, nn.Module], str]) ->torch._C.Graph:
+    """
+    Traces the module with scope annotations for each submodule.
+    """
+    if isinstance(inputs, Tensor):
+        inputs = (inputs,)
+
+    hooks = []
+
+    def pre_hook(mod, inputs):
+        name = aliases.get(mod)
+        if name is not None:
+            torch.jit._state._set_current_module_scope(name)
+
+    # Use forward hooks to annotate scope names
+    # The scope name for each node is set via the module's scope stack
+    
+    class ScopeTracker:
+        def __init__(self):
+            self.scope_stack = []
+        
+        def push(self, name):
+            self.scope_stack.append(name)
+        
+        def pop(self):
+            if self.scope_stack:
+                self.scope_stack.pop()
+        
+        def current(self):
+            return "/".join(self.scope_stack)
+
+    tracker = ScopeTracker()
+    
+    for mod in list(aliases.keys()):
+        if isinstance(mod, nn.Module):
+            name = aliases[mod]
+            
+            def make_pre(n):
+                def hook(m, i):
+                    tracker.push(n)
+                return hook
+            
+            def make_post(n):
+                def hook(m, i, o):
+                    tracker.pop()
+                return hook
+            
+            hooks.append(mod.register_forward_pre_hook(make_pre(name)))
+            hooks.append(mod.register_forward_hook(make_post(name)))
+
+    try:
+        graph, _ = _get_trace_graph(module, inputs, strict=False)
+    finally:
+        for h in hooks:
+            h.remove()
+
+    torch._C._jit_pass_inline(graph)
+    return graph
