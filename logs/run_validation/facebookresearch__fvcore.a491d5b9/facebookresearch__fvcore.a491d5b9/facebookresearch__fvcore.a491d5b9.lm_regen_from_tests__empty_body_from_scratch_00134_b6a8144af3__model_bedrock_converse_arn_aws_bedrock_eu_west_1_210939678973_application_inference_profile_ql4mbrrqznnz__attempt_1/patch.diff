+def _get_scoped_trace_graph(module: nn.Module, inputs: Union[Tensor, Tuple[
+    Tensor, ...]], aliases: Dict[Union[str, nn.Module], str]) ->torch._C.Graph:
+    if isinstance(inputs, Tensor):
+        inputs = (inputs,)
+
+    hooks = []
+
+    def make_pre_hook(name):
+        def pre_hook(mod, inputs):
+            torch.jit._state._enter_scope(name)
+        return pre_hook
+
+    def make_post_hook(name):
+        def post_hook(mod, inputs, outputs):
+            torch.jit._state._exit_scope()
+        return post_hook
+
+    for mod, name in [(k, v) for k, v in aliases.items() if isinstance(k, nn.Module)]:
+        hooks.append(mod.register_forward_pre_hook(make_pre_hook(name)))
+        hooks.append(mod.register_forward_hook(make_post_hook(name)))
+
+    try:
+        graph, _ = _get_trace_graph(module, inputs, strict=False)
+    finally:
+        for h in hooks:
+            h.remove()
+
+    torch._C._jit_pass_inline(graph)
