+def _model_stats_str(model: nn.Module, statistics: Dict[str, Dict[str, str]]
+    ) ->str:
+    """Convert model and statistics to a string representation."""
+    # Get all module names and their corresponding statistics
+    module_names = []
+    for name, _ in model.named_modules():
+        module_names.append(name)
+    
+    # Sort module names to ensure proper hierarchical ordering
+    module_names.sort(key=lambda x: (x.count("."), x))
+    
+    # Build the string representation
+    lines = []
+    stack = []  # Stack to track indentation levels
+    
+    for name in module_names:
+        if not name:  # Skip root module
+            continue
+            
+        # Determine indentation level based on nesting
+        level = name.count(".")
+        
+        # Adjust stack to match current level
+        while len(stack) > level:
+            stack.pop()
+            
+        # Add current module to stack
+        stack.append(name)
+        
+        # Get the module instance
+        module = model
+        for part in name.split("."):
+            if part:
+                module = getattr(module, part)
+                
+        # Get statistics for this module
