+def _remove_zero_statistics(statistics: Dict[str, Dict[str, int]],
+    force_keep: Optional[Set[str]]=None, require_trivial_children: bool=False
+    ) ->Dict[str, Dict[str, int]]:
+    if force_keep is None:
+        force_keep = set()
+    
+    # First, identify which modules to keep based on force_keep
+    to_keep = set(force_keep)
+    
+    # If require_trivial_children is True, we need to check if modules have non-zero children
+    if require_trivial_children:
+        # Build a set of all module names
+        all_modules = set(statistics.keys())
+        
+        # For each module, check if it has any non-zero children
+        for mod_name in list(statistics.keys()):
+            if mod_name in to_keep:
+                continue
+                
+            # Check if this module has any children with non-zero stats
+            has_nonzero_child = False
+            for child_name in all_modules:
+                # Check if child_name is a direct child of mod_name
+                if child_name.startswith(mod_name + "."):
+                    # Check if any statistic for this child is non-zero
+                    if any(stat_val != 0 for stat_val in statistics[child_name].values()):
+                        has_nonzero_child = True
+                        break
+            
+            # If module has non-zero children, keep it even if it's all zeros
+            if has_nonzero_child:
+                to_keep.add(mod_name)
+    
+    # Filter out modules that are all zero and not in force_keep
+    result = {}
+    for mod_name, stats in statistics.items():
+        # Keep if explicitly forced or if it has non-zero stats
+        if mod_name in to_keep or any(stat_val != 0 for stat_val in stats.values()):
+            result[mod_name] = stats
+    
+    return result
 
 
