+def parameter_count(model: nn.Module) ->typing.DefaultDict[str, int]:
+    count: typing.DefaultDict[str, int] = defaultdict(int)
+    
+    def _get_name(module: nn.Module) -> str:
+        # Get the name of the module by traversing the module tree
+        for name, mod in model.named_modules():
+            if mod is module:
+                return name
+        return ""
+    
+    for name, param in model.named_parameters():
+        # Get the module name for this parameter
+        module_name = ""
+        for module_name, module in model.named_modules():
+            if param in module.parameters():
+                break
+        
+        # If module_name is empty, it's a top-level parameter
+        if not module_name:
+            count[""] += param.numel()
+        else:
+            count[module_name] += param.numel()
+            
+    return count
 
 
