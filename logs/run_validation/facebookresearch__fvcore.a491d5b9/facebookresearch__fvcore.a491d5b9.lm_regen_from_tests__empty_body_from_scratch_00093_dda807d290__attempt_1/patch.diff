+def _remove_zero_statistics(statistics: Dict[str, Dict[str, int]],
+    force_keep: Optional[Set[str]]=None, require_trivial_children: bool=False
+    ) ->Dict[str, Dict[str, int]]:
+    if force_keep is None:
+        force_keep = set()
+    
+    # First pass: identify modules to keep
+    to_keep = set(force_keep)
+    
+    for mod_name, stats in statistics.items():
+        # Keep if any statistic is non-zero
+        if any(v != 0 for v in stats.values()):
+            to_keep.add(mod_name)
+    
+    # If require_trivial_children, also keep parents of kept modules
+    if require_trivial_children:
+        # Keep a module if it has any children that are being kept
+        changed = True
+        while changed:
+            changed = False
+            for mod_name in list(to_keep):
+                # Check if this module is a child of any module not in to_keep
+                parts = mod_name.split('.')
+                for i in range(len(parts) - 1):
+                    parent = '.'.join(parts[:i+1])
+                    if parent not in to_keep and parent in statistics:
+                        to_keep.add(parent)
+                        changed = True
+    else:
+        # Without require_trivial_children, still keep parents if they have non-zero stats
+        # or if they're in force_keep
+        changed = True
+        while changed:
+            changed = False
+            for mod_name in list(to_keep):
+                parts = mod_name.split('.')
+                for i in range(len(parts) - 1):
+                    parent = '.'.join(parts[:i+1])
+                    if parent not in to_keep and parent in statistics:
+                        # Only keep parent if it has non-zero stats or is force_kept
+                        if any(v != 0 for v in statistics[parent].values()) or parent in force_keep:
+                            to_keep.add(parent)
+                            changed = True
+    
+    return {mod: stats for mod, stats in statistics.items() if mod in to_keep}
