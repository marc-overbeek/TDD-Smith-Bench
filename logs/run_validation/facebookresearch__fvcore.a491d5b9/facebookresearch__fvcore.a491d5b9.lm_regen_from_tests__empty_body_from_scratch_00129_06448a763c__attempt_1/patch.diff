+def elementwise_flop_counter(input_scale: float=1, output_scale: float=0
+    ) ->Handle:
+    """
+    Count flops for elementwise operations.
+    
+    Args:
+        input_scale: scale factor for input size
+        output_scale: scale factor for output size
+    
+    Returns:
+        Handle: A function that counts flops for elementwise operations
+    """
+    def elementwise_flop_jit(inputs: List[Any], outputs: List[Any]) -> Number:
+        """
+        Count flops for elementwise operations.
+        """
+        input_shape = get_shape(inputs[0])
+        output_shape = get_shape(outputs[0])
+        
+        flop = 0
+        if input_scale != 0 and input_shape is not None:
+            flop += input_scale * prod(input_shape)
+        if output_scale != 0 and output_shape is not None:
+            flop += output_scale * prod(output_shape)
+        
+        return flop
+    
+    return elementwise_flop_jit
