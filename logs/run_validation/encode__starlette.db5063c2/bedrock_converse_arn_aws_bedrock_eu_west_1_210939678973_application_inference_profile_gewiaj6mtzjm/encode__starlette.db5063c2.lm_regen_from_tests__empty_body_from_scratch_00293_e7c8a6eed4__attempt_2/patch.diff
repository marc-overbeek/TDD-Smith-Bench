+def cookie_parser(cookie_string: str) ->dict[str, str]:
+    cookies: dict[str, str] = {}
+    if not cookie_string:
+        return cookies
+    
+    # Use http.cookies.SimpleCookie for proper parsing
+    # This handles quoted values, spaces around =, etc.
+    try:
+        cookie = http_cookies.SimpleCookie()
+        cookie.load(cookie_string)
+        for key, morsel in cookie.items():
+            cookies[key] = morsel.value
+    except Exception:
+        # Fallback to manual parsing for malformed cookies
+        for cookie in cookie_string.split(";"):
+            cookie = cookie.strip()
+            if cookie:
+                try:
+                    key, value = cookie.split("=", 1)
+                    # Handle spaces around the equals sign
+                    key = key.strip()
+                    value = value.strip()
+                    if key:  # Only add non-empty keys
+                        cookies[key] = value
+                except ValueError:
+                    # Invalid cookie syntax, skip this cookie
+                    continue
+    return cookies
 
 
