+def replace_params(path: str, param_convertors: dict[str, Convertor[typing.
+    Any]], path_params: dict[str, str]) ->tuple[str, dict[str, str]]:
+    output = ""
+    idx = 0
+    for match in PARAM_REGEX.finditer(path):
+        param_name, convertor_type = match.groups("str")
+        convertor_type = convertor_type.lstrip(":")
+        convertor = CONVERTOR_TYPES[convertor_type]
+        output += path[idx : match.start()]
+        if param_name in path_params:
+            param_value = path_params[param_name]
+            if not isinstance(param_value, str):
+                param_value = str(param_value)
+            if param_name in param_convertors:
+                param_value = param_convertors[param_name].serialize(param_value)
+            output += param_value
+            path_params.pop(param_name)
+        else:
+            output += "{" + param_name + "}"
+        idx = match.end()
+    output += path[idx:]
+    return output, path_params
 
 
