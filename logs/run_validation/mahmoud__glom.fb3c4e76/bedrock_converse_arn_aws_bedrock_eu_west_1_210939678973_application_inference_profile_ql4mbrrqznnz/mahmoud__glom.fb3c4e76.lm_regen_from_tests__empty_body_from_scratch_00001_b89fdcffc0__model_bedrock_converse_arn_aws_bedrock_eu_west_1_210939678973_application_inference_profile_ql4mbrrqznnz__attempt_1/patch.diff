+def _unpack_stack(scope, only_errors=True):
+    # Build chain from root to current scope
+    chain = []
+    cur = scope
+    visited = set()
+    while cur is not None:
+        cur_id = id(cur.maps[0])
+        if cur_id in visited:
+            break
+        visited.add(cur_id)
+        m = cur.maps[0]
+        if T in m and Spec in m:
+            chain.append(cur)
+        parent = m.get(UP)
+        if parent is None or parent is cur:
+            break
+        cur = parent
+
+    chain.reverse()  # root first, current last
+
+    for scope_item in chain:
+        m = scope_item.maps[0]
+        target = m.get(T, _MISSING)
+        spec = m.get(Spec, _MISSING)
+        if target is _MISSING or spec is _MISSING:
+            continue
+        error = m.get(CUR_ERROR, None)
+        child_errors = m.get(CHILD_ERRORS, [])
