+def _unpack_stack(scope, only_errors=True):
+    """Unpack a scope chain into (scope, spec, target, error, branches) tuples."""
+    # Walk up to find the root
+    cur = scope
+    while len(cur.maps) > 1 and UP in cur.maps[1]:
+        parent = cur.maps[1].get(UP)
+        if parent is cur or parent is None:
+            break
+        cur = parent
+    
+    # Collect path from root to the original scope
+    path = []
+    s = cur
+    visited = set()
+    while s is not None:
+        if id(s) in visited:
+            break
+        visited.add(id(s))
+        path.append(s)
+        if len(s.maps) > 1:
+            s = s.maps[1].get(UP)
+        else:
+            break
+    
+    # Yield scopes from root to leaf
+    for s in path:
+        spec = s.maps[0].get(Spec, _MISSING)
+        target = s.maps[0].get(T, _MISSING)
+        error = s.maps[0].get(CUR_ERROR, None)
+        child_errors = s.maps[0].get(CHILD_ERRORS, [])
+        
+        if not only_errors or error is not None or child_errors:
