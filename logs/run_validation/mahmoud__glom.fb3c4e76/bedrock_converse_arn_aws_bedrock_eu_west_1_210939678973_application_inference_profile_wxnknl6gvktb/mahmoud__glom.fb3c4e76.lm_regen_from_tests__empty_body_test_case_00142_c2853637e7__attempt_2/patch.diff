+def format_target_spec_trace(scope, root_error, width=TRACE_WIDTH, depth=0,
+    prev_target=_MISSING, last_branch=True):
+    lines = []
+    stack = _unpack_stack(scope, only_errors=True)
+    
+    for i, (cur_scope, spec, target, error, branches) in enumerate(stack):
+        is_last = (i == len(stack) - 1)
+        
+        if target is not _MISSING and target != prev_target:
+            prefix = ' - ' if depth == 0 else ' ' * (depth + 1) + '- '
+            target_repr = _format_trace_value(target, width - len(prefix) - 10)
+            lines.append(f'{prefix}Target: {target_repr}')
+            prev_target = target
+        
+        if spec is not _MISSING:
+            if branches:
+                prefix = ' + ' if depth == 0 else ' ' * (depth + 1) + '+ '
+                spec_repr = _format_trace_value(spec, width - len(prefix) - 10)
+                lines.append(f'{prefix}Spec: {spec_repr}')
+                
+                for j, branch_scope in enumerate(branches):
+                    is_last_branch = (j == len(branches) - 1)
+                    branch_prefix = ' ' * (depth + 1) + ('|\\' if not is_last_branch else '|\\')
+                    branch_spec = branch_scope.get(Spec, _MISSING)
+                    if branch_spec is not _MISSING:
+                        spec_repr = _format_trace_value(branch_spec, width - len(branch_prefix) - 10)
+                        lines.append(f'{branch_prefix} Spec: {spec_repr}')
+                    
+                    branch_error = branch_scope.get(CUR_ERROR, _MISSING)
+                    if branch_error is not _MISSING:
+                        error_prefix = ' ' * (depth + 1) + ('|X' if not is_last_branch else '|X')
+                        error_repr = _format_trace_value(branch_error, width - len(error_prefix) - 10)
+                        lines.append(f'{error_prefix} {error_repr.__class__.__name__}: {str(branch_error)[:width - len(error_prefix) - 20]}')
+            else:
+                prefix = ' - ' if depth == 0 else ' ' * (depth + 1) + '- '
+                spec_repr = _format_trace_value(spec, width - len(prefix) - 10)
+                lines.append(f'{prefix}Spec: {spec_repr}')
+        
+        if error is not _MISSING and is_last:
+            error_repr = str(error)
+            if len(error_repr) > width - 10:
+                error_repr = error_repr[:width - 13] + '...'
+            lines.append(error_repr)
+    
+    return '\n'.join(lines)
 
 
