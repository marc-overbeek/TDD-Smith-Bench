+def format_target_spec_trace(scope, root_error, width=TRACE_WIDTH, depth=0,
+    prev_target=_MISSING, last_branch=True):
+    lines = []
+    stack = _unpack_stack(scope, only_errors=True)
+    
+    for i, (cur_scope, spec, target, error, branches) in enumerate(stack):
+        indent = ' ' * depth
+        prefix = ' - ' if last_branch else ' | '
+        
+        if target is not _MISSING and target != prev_target:
+            target_repr = _format_trace_value(target, width - len(indent) - 10)
+            lines.append(f'{indent} - Target: {target_repr}')
+            prev_target = target
+        
+        if spec is not _MISSING:
+            spec_repr = _format_trace_value(spec, width - len(indent) - 10)
+            if branches:
+                lines.append(f'{indent} + Spec: {spec_repr}')
+                for j, branch_scope in enumerate(branches):
+                    is_last = j == len(branches) - 1
+                    branch_lines = format_target_spec_trace(
+                        branch_scope, root_error, width, depth + 2,
+                        prev_target, is_last
+                    )
+                    if branch_lines:
+                        branch_prefix = ' |\\ ' if not is_last else ' |\\ '
+                        first_line = True
+                        for line in branch_lines.split('\n'):
+                            if line:
+                                if first_line:
+                                    lines.append(f'{indent}{branch_prefix}{line}')
+                                    first_line = False
+                                else:
+                                    lines.append(f'{indent} | {line}')
+                        if error is not _MISSING:
+                            error_repr = _format_trace_value(error, width - len(indent) - 10)
+                            lines.append(f'{indent} |X {error_repr}')
+            else:
+                lines.append(f'{indent} - Spec: {spec_repr}')
+        
+        if error is not _MISSING and not branches:
+            error_repr = _format_trace_value(error, width - len(indent) - 10)
+            lines.append(f'{indent}{error_repr}')
+    
+    return '\n'.join(lines)
 
 
