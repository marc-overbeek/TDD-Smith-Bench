+def format_time(time: mod_datetime.datetime) ->str:
+    if time is None:
+        return ''
+    
+    time_str = time.strftime('%Y-%m-%dT%H:%M:%S')
+    
+    if time.microsecond:
+        time_str += f'.{time.microsecond:06d}'.rstrip('0')
+    
+    if time.tzinfo:
+        tz_name = time.tzinfo.tzname(time)
+        if tz_name == 'Z':
+            time_str += 'Z'
+        else:
+            time_str += tz_name
+    
+    return time_str
 
 
 
