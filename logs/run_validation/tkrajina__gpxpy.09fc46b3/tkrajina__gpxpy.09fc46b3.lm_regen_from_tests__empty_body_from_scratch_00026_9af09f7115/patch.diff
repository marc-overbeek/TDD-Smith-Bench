+    def move_by_angle_and_distance(self, location: Location) ->Tuple[float, float]:
+        # Convert angle to radians
+        angle_rad = mod_math.radians(self.angle_from_north)
+    
+        # Earth radius in meters
+        earth_radius = EARTH_RADIUS
+    
+        # Calculate angular distance
+        angular_distance = self.distance / earth_radius
+    
+        # Calculate new latitude
+        lat_rad = mod_math.radians(location.latitude)
+        lon_rad = mod_math.radians(location.longitude)
+    
+        # Calculate new latitude
+        new_lat_rad = mod_math.asin(
+            mod_math.sin(lat_rad) * mod_math.cos(angular_distance) +
+            mod_math.cos(lat_rad) * mod_math.sin(angular_distance) * mod_math.cos(angle_rad)
+        )
+    
+        # Calculate new longitude
+        y = mod_math.sin(angle_rad) * mod_math.sin(angular_distance) * mod_math.cos(lat_rad)
+        x = mod_math.cos(angular_distance) - mod_math.sin(lat_rad) * mod_math.sin(new_lat_rad)
+        new_lon_rad = lon_rad + mod_math.atan2(y, x)
+    
+        # Convert back to degrees
+        new_latitude = mod_math.degrees(new_lat_rad)
+        new_longitude = mod_math.degrees(new_lon_rad)
+    
+        # Normalize longitude to [-180, 180]
+        new_longitude = ((new_longitude + 180) % 360) - 180
+    
+        return new_latitude, new_longitude
 
     def move_by_lat_lon_diff(self, location: "Location") -> Tuple[float, float]:
