+def join_gpxs(xmls: Iterable[AnyStr]) ->str:
+    if not xmls:
+        return ''
+    
+    # Parse the first XML to get the base structure
+    dom = mod_minidom.parseString(list(xmls)[0])
+    gpx_node = _find_gpx_node(dom)
+    
+    # For each subsequent XML, parse and merge its content
+    for xml_str in list(xmls)[1:]:
+        if not xml_str.strip():
+            continue
+        try:
+            other_dom = mod_minidom.parseString(xml_str)
+            other_gpx_node = _find_gpx_node(other_dom)
+            
+            if other_gpx_node:
+                # Move all children from other GPX node to main GPX node
+                for child_node in other_gpx_node.childNodes[:]:  # Use slice to avoid modification during iteration
+                    if child_node.nodeType == mod_minidom.Node.ELEMENT_NODE:
+                        # Clone the node to avoid moving from original DOM
+                        cloned_node = child_node.cloneNode(True)
+                        gpx_node.appendChild(cloned_node)
+        except Exception:
+            # If parsing fails, skip this XML
+            continue
+    
+    return dom.toxml()
 
