+def format_time(time: mod_datetime.datetime) ->str:
+    if time is None:
+        return ''
+    
+    # Format the basic datetime part
+    if time.microsecond:
+        # Include microseconds with trailing zeros removed
+        formatted_time = time.strftime('%Y-%m-%dT%H:%M:%S')
+        # Remove trailing zeros from microseconds
+        microsecond_str = str(time.microsecond).rstrip('0')
+        if microsecond_str:
+            formatted_time += f'.{microsecond_str}'
+    else:
+        formatted_time = time.strftime('%Y-%m-%dT%H:%M:%S')
+    
+    # Handle timezone
+    if time.tzinfo is not None:
+        offset = time.tzinfo.utcoffset(time)
+        if offset == mod_datetime.timedelta(0):
+            formatted_time += 'Z'
+        else:
+            # Format timezone offset
+            total_minutes = int(offset.total_seconds() // 60)
+            hours = total_minutes // 60
+            minutes = abs(total_minutes % 60)
+            if minutes == 0:
+                formatted_time += f'{hours:+03d}'
+            else:
+                formatted_time += f'{hours:+03d}:{minutes:02d}'
+    else:
+        formatted_time += 'Z'
+    
+    return formatted_time
 
 
 
