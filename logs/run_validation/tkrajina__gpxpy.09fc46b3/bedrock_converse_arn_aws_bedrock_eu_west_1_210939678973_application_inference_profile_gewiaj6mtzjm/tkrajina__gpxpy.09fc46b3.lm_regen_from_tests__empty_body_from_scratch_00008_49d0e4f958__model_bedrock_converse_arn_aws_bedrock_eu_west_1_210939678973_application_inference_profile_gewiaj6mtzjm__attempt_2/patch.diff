+def distance(latitude_1: float, longitude_1: float, elevation_1: Optional[
+    float], latitude_2: float, longitude_2: float, elevation_2: Optional[
+    float], haversine: bool=False) ->float:
+    if haversine:
+        d = haversine_distance(latitude_1, longitude_1, latitude_2, longitude_2)
+    else:
+        # Handle longitude wrapping around the 0-degree meridian
+        d_lon = longitude_1 - longitude_2
+        # Normalize longitude difference to [-180, 180] range
+        if d_lon > 180:
+            d_lon -= 360
+        elif d_lon < -180:
+            d_lon += 360
+            
+        d = ONE_DEGREE * mod_math.sqrt(
+            (latitude_1 - latitude_2) ** 2 +
+            (d_lon) ** 2)
+
+    if elevation_1 is not None and elevation_2 is not None:
+        d = mod_math.sqrt(d**2 + (elevation_1 - elevation_2)**2)
