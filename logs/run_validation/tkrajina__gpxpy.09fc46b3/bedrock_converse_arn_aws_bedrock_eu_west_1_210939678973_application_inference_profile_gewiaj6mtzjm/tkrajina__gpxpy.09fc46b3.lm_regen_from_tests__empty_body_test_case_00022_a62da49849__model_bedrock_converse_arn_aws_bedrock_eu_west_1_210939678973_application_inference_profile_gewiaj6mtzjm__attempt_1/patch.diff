+def gpx_fields_from_xml(class_or_instance: Any, node: str, version: str) ->Any:
+    if node is None:
+        return None
+    
+    # Create instance if needed
+    if not isinstance(class_or_instance, type):
+        instance = class_or_instance
+    else:
+        instance = class_or_instance()
+    
+    # Get fields based on version
+    if version == '1.0':
+        fields = getattr(instance, 'gpx_10_fields', [])
+    else:
+        fields = getattr(instance, 'gpx_11_fields', [])
+    
+    # Process each field
+    for field in fields:
+        if isinstance(field, str):
+            # Simple field name
+            field_name = field
+            # For simple fields, we'd typically handle them differently
+            # But since this is a generic method, we'll let the field handle it
+            pass
+        else:
+            # Complex field
+            value = field.from_xml(node, version)
+            if value is not None:
+                setattr(instance, field.name, value)
+    
+    return instance
 
