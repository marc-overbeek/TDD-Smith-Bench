+def get_line_equation_coefficients(location1: 'Location', location2: 'Location'
+    ) ->Iterable[float]:
+    # Calculate coefficients (a, b, c) for the line equation ax + by + c = 0
+    # Given two points (x1, y1) and (x2, y2)
+    x1, y1 = location1.longitude, location1.latitude
+    x2, y2 = location2.longitude, location2.latitude
+    
+    a = y2 - y1
+    b = x1 - x2
+    c = x2 * y1 - x1 * y2
+    
+    return (a, b, c)
+
