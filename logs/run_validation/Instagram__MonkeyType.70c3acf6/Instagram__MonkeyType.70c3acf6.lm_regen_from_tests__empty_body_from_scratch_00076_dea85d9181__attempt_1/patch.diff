+def get_monkeytype_config(path: str) ->Config:
+    if ":" in path:
+        module_name, qualname = path.split(":", 1)
+        module = importlib.import_module(module_name)
+        config = getattr(module, qualname)
+        if callable(config):
+            return config()
+        return config
+    else:
+        # Default case - try to import the module and get CONFIG or DefaultConfig
+        try:
+            module = importlib.import_module(path)
+            if hasattr(module, "CONFIG"):
+                return module.CONFIG
+            elif hasattr(module, "DefaultConfig"):
+                return module.DefaultConfig()
+        except ImportError:
+            pass
+        # Fallback to default config
+        from monkeytype.config import DefaultConfig
