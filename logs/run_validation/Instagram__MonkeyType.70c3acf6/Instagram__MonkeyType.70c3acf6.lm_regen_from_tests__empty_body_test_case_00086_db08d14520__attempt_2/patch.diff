+def shrink_typed_dict_types(typed_dicts: List[type], max_typed_dict_size: int
+    ) ->type:
+    if not typed_dicts:
+        return Dict[str, Any]
+    if len(typed_dicts) == 1:
+        return typed_dicts[0]
+    if max_typed_dict_size == 0:
+        return Dict[str, Any]
+    
+    # Collect all field names and their types across all typed dicts
+    all_required_fields = defaultdict(list)
+    all_optional_fields = defaultdict(list)
+    
+    for td in typed_dicts:
+        required, optional = field_annotations(td)
+        for field, typ in required.items():
+            all_required_fields[field].append(typ)
+        for field, typ in optional.items():
+            all_optional_fields[field].append(typ)
+    
+    # Shrink each field's types
+    shrunk_required = {}
+    shrunk_optional = {}
+    
+    for field, types in all_required_fields.items():
+        shrunk_required[field] = shrink_types(types, max_typed_dict_size)
+    
+    for field, types in all_optional_fields.items():
+        shrunk_optional[field] = shrink_types(types, max_typed_dict_size)
+    
+    # If we exceed the max size, fall back to Any
+    if (len(shrunk_required) + len(shrunk_optional)) > max_typed_dict_size:
+        return Dict[str, Any]
+    
+    return make_typed_dict(required_fields=shrunk_required, optional_fields=shrunk_optional)
 
 
