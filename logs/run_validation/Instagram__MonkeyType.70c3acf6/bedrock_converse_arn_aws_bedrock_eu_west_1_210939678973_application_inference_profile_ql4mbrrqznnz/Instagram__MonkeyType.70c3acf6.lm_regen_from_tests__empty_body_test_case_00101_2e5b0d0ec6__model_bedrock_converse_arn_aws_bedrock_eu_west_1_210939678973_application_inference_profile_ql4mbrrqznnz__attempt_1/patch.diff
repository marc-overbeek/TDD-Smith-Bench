+def shrink_typed_dict_types(typed_dicts: List[type], max_typed_dict_size: int
+    ) ->type:
+    if not typed_dicts:
+        return Dict[Any, Any]
+    
+    all_required = {}
+    all_optional = {}
+    all_keys = set()
+    
+    for td in typed_dicts:
+        required, optional = field_annotations(td)
+        all_keys.update(required.keys())
+        all_keys.update(optional.keys())
+    
+    for key in all_keys:
+        key_types = []
+        is_optional = False
+        for td in typed_dicts:
+            required, optional = field_annotations(td)
+            if key in required:
+                key_types.append(required[key])
+            elif key in optional:
+                key_types.append(optional[key])
+                is_optional = True
+            else:
+                is_optional = True
+        
+        merged_type = shrink_types(key_types, max_typed_dict_size)
+        if is_optional:
+            all_optional[key] = merged_type
+        else:
+            all_required[key] = merged_type
+    
+    total_size = len(all_required) + len(all_optional)
+    if max_typed_dict_size is not None and total_size > max_typed_dict_size:
+        all_value_types = list(all_required.values()) + list(all_optional.values())
+        if not all_value_types:
+            return Dict[Any, Any]
+        return Dict[str, Union[tuple(all_value_types)]]
+    
+    return make_typed_dict(required_fields=all_required, optional_fields=all_optional)
 
 
