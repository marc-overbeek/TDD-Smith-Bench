+def render_signature(sig: inspect.Signature, max_line_len: Optional[int]=
+    None, prefix: str='') ->str:
+    # Get all parameters as strings
+    param_strings = [render_parameter(p) for p in sig.parameters.values()]
+    
+    # Check if we need to split across multiple lines
+    if max_line_len is not None:
+        # Calculate the length of the opening part of the signature
+        opening_len = len(prefix) + 4  # "def " + function name + "("
+        
+        # Try to fit everything on one line
+        if len(param_strings) > 0:
+            # Join parameters with commas and spaces
+            joined_params = ", ".join(param_strings)
+            if len(joined_params) + opening_len <= max_line_len:
+                return f"({joined_params})"
+        
+        # If we can't fit on one line, split parameters across multiple lines
+        if len(param_strings) > 0:
+            indented_params = [f"{prefix}    {p}" for p in param_strings]
+            return f"(\n{',\n'.join(indented_params)}\n{prefix})"
+    
+    # Default behavior: join parameters with commas
+    if len(param_strings) == 0:
+        return "()"
+    else:
+        return f"({', '.join(param_strings)})"
 
 
