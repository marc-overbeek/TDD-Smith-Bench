+def render_signature(sig: inspect.Signature, max_line_len: Optional[int]=
+    None, prefix: str='') ->str:
+    params = [p for name, p in sig.parameters.items()]
+    rendered_params = [render_parameter(p) for p in params]
+    if sig.return_annotation is not inspect.Parameter.empty:
+        return_annotation = ' -> ' + render_annotation(sig.return_annotation)
+    else:
+        return_annotation = ''
+    single_line = '(' + ', '.join(rendered_params) + ')' + return_annotation
+    if max_line_len is None or len(single_line) <= max_line_len:
+        return single_line
+    inner_prefix = prefix + '    '
+    lines = ['(']
+    for i, param_str in enumerate(rendered_params):
+        comma = ',' if i < len(rendered_params) - 1 else ''
+        lines.append(inner_prefix + param_str + comma)
+    lines.append(prefix + ')' + return_annotation)
+    return '\n'.join(lines)
 
 
