+def shrink_typed_dict_types(typed_dicts: List[type], max_typed_dict_size: int
+    ) ->type:
+    if not typed_dicts:
+        return Dict[Any, Any]
+    
+    merged_required = {}
+    merged_optional = {}
+    
+    for td in typed_dicts:
+        req, opt = field_annotations(td)
+        for k, v in req.items():
+            if k not in merged_required:
+                merged_required[k] = []
+            merged_required[k].append(v)
+        for k, v in opt.items():
+            if k not in merged_optional:
+                merged_optional[k] = []
+            merged_optional[k].append(v)
+    
+    all_keys = set()
+    for td in typed_dicts:
+        req, opt = field_annotations(td)
+        all_keys.update(req.keys())
+        all_keys.update(opt.keys())
+    
+    first_req, _ = field_annotations(typed_dicts[0])
+    first_keys = set(first_req.keys())
+    
+    common_required_keys = first_keys.copy()
+    for td in typed_dicts[1:]:
+        req, _ = field_annotations(td)
+        common_required_keys &= set(req.keys())
+    
+    final_required = {}
+    final_optional = {}
+    
+    for k in all_keys:
+        types_for_key = merged_required.get(k, []) + merged_optional.get(k, [])
+        shrunk = shrink_types(types_for_key, max_typed_dict_size)
+        if k in common_required_keys:
+            final_required[k] = shrunk
+        else:
+            final_optional[k] = shrunk
+    
+    total_size = len(final_required) + len(final_optional)
+    if max_typed_dict_size is not None and total_size > max_typed_dict_size:
+        all_value_types = list(final_required.values()) + list(final_optional.values())
+        val_type = shrink_types(all_value_types, max_typed_dict_size)
+        return Dict[str, val_type]
+    
+    return make_typed_dict(required_fields=final_required, optional_fields=final_optional)
 
 
