+def update_signature_args(sig: inspect.Signature, arg_types: Dict[str, type
+    ], has_self: bool, existing_annotation_strategy:
+    ExistingAnnotationStrategy=ExistingAnnotationStrategy.REPLICATE
+    ) ->inspect.Signature:
+    new_params = []
+    for i, param in enumerate(sig.parameters.values()):
+        if has_self and i == 0:
+            new_params.append(param)
+            continue
+        
+        if param.name in arg_types:
+            new_type = arg_types[param.name]
+            
+            if new_type is None:
+                new_params.append(param.replace(annotation=inspect.Parameter.empty))
+            elif param.annotation is inspect.Parameter.empty:
+                new_params.append(param.replace(annotation=new_type))
+            elif existing_annotation_strategy == ExistingAnnotationStrategy.REPLICATE:
+                new_params.append(param)
+            elif existing_annotation_strategy == ExistingAnnotationStrategy.IGNORE:
+                new_params.append(param.replace(annotation=new_type))
+            elif existing_annotation_strategy == ExistingAnnotationStrategy.OMIT:
+                new_params.append(param.replace(annotation=inspect.Parameter.empty))
+            else:
+                new_params.append(param)
+        else:
+            new_params.append(param)
+    
+    return sig.replace(parameters=new_params)
+
+
+def update_signature_return(sig: inspect.Signature, return_type: Optional[
+    type]=None, yield_type: Optional[type]=None,
+    existing_annotation_strategy: ExistingAnnotationStrategy=
+    ExistingAnnotationStrategy.REPLICATE) ->inspect.Signature:
+    if yield_type is not None:
+        if return_type is None or return_type is NoneType:
+            return_annotation = make_iterator(yield_type)
+        else:
+            return_annotation = make_generator(yield_type, return_type)
+        return sig.replace(return_annotation=return_annotation)
+    
+    if return_type is None:
+        return sig
+    
+    if sig.return_annotation is inspect.Signature.empty:
+        return sig.replace(return_annotation=return_type)
+    elif existing_annotation_strategy == ExistingAnnotationStrategy.REPLICATE:
+        return sig
+    elif existing_annotation_strategy == ExistingAnnotationStrategy.IGNORE:
+        return sig.replace(return_annotation=return_type)
+    elif existing_annotation_strategy == ExistingAnnotationStrategy.OMIT:
+        return sig.replace(return_annotation=inspect.Signature.empty)
+    else:
+        return sig
 
 
