+def render_parameter(param: inspect.Parameter) ->str:
+    s = param.name
+    if param.annotation != inspect.Parameter.empty:
+        s += ': ' + render_annotation(param.annotation)
+    if param.default != inspect.Parameter.empty:
+        s += ' = ...'
+    return s
+
+
+def render_signature(sig: inspect.Signature, max_line_len: Optional[int]=
+    None, prefix: str='') ->str:
+    params = [render_parameter(p) for p in sig.parameters.values()]
+    
+    return_annotation = ''
+    if sig.return_annotation != inspect.Signature.empty:
+        return_annotation = ' -> ' + render_annotation(sig.return_annotation)
+    
+    if not params:
+        return f"({return_annotation})"
+    
+    single_line = f"({', '.join(params)}){return_annotation}"
+    
+    if max_line_len is None or len(single_line) <= max_line_len:
+        return single_line
+    
+    lines = ['(']
+    for param in params:
+        lines.append(f"    {param},")
+    lines.append(f"){return_annotation}")
+    
+    return '\n'.join([prefix + line if i > 0 else line for i, line in enumerate(lines)])
 
 
