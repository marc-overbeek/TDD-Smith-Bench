+def render_signature(sig: inspect.Signature, max_line_len: Optional[int]=
+    None, prefix: str='') ->str:
+    params = [render_parameter(p) for p in sig.parameters.values()]
+    if max_line_len is None:
+        return f"({', '.join(params)})"
+
+    # Try to fit all parameters on one line
+    joined_params = ", ".join(params)
+    if len(joined_params) <= max_line_len:
+        return f"({joined_params})"
+
+    # If that fails, put each parameter on its own line
+    indented_params = ",\n".join(f"{prefix}    {p}" for p in params)
+    return f"(\n{indented_params}\n{prefix})"
 
 
