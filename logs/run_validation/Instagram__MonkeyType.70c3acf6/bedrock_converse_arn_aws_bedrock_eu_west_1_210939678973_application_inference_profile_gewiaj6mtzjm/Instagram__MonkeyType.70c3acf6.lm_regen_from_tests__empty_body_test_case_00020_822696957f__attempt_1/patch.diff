+def update_signature_args(sig: inspect.Signature, arg_types: Dict[str, type
+    ], has_self: bool, existing_annotation_strategy:
+    ExistingAnnotationStrategy=ExistingAnnotationStrategy.REPLICATE
+    ) ->inspect.Signature:
+    new_params = []
+    for i, (param_name, param) in enumerate(sig.parameters.items()):
+        if i == 0 and has_self:
+            new_params.append(param)
+        elif param_name in arg_types:
+            new_type = arg_types[param_name]
+            if existing_annotation_strategy == ExistingAnnotationStrategy.IGNORE:
+                new_params.append(param.replace(annotation=new_type))
+            elif existing_annotation_strategy == ExistingAnnotationStrategy.OMIT:
+                if param.annotation is inspect.Parameter.empty:
+                    new_params.append(param.replace(annotation=new_type))
+                else:
+                    new_params.append(param)
+            else:  # REPLICATE
+                if param.annotation is inspect.Parameter.empty:
+                    new_params.append(param.replace(annotation=new_type))
+                else:
+                    new_params.append(param)
+        else:
+            new_params.append(param)
+    return sig.replace(parameters=new_params)
+
+
+def update_signature_return(sig: inspect.Signature, return_type: Optional[
+    type]=None, yield_type: Optional[type]=None,
+    existing_annotation_strategy: ExistingAnnotationStrategy=
+    ExistingAnnotationStrategy.REPLICATE) ->inspect.Signature:
+    if return_type is None and yield_type is None:
+        return sig
+    if yield_type is not None and return_type is None:
+        return sig.replace(return_annotation=make_iterator(yield_type))
+    if yield_type is not None and return_type is not None:
+        return sig.replace(return_annotation=make_generator(yield_type, return_type))
+    if return_type is not None:
+        if existing_annotation_strategy == ExistingAnnotationStrategy.IGNORE:
+            return sig.replace(return_annotation=return_type)
+        elif existing_annotation_strategy == ExistingAnnotationStrategy.OMIT:
+            if sig.return_annotation is inspect.Signature.empty:
+                return sig.replace(return_annotation=return_type)
+            else:
+                return sig
+        else:  # REPLICATE
+            if sig.return_annotation is inspect.Signature.empty:
+                return sig.replace(return_annotation=return_type)
+            else:
+                return sig
+    return sig
+
