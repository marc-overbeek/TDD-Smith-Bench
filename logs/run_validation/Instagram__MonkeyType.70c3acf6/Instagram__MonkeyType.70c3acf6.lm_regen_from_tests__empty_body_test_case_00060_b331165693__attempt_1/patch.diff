+        # Try to fit parameters on one line
+        joined_params = ", ".join(param_strs)
+        if len(joined_params) + line_len <= max_line_len:
+            return f"({joined_params})"
+        
+        # If that doesn't work, split parameters across multiple lines
+        indented_params = [f"{prefix}    {p}" for p in param_strs]
+        return f"(\n{',\n'.join(indented_params)}\n{prefix})"
+
